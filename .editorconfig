# https://aka.ms/editorconfigdocs

root = true

###############################
# Core EditorConfig Options   #
###############################

# Xml files
[*.{csproj,config,nuspec,xml,resx,ruleset,props,targets}]
indent_size = 2

# Code files
[*.{cs,csx,vb,vbx,cake,json}]
indent_size = 4
charset = utf-8-bom

# Shell scripts
[*.sh]
end_of_line = lf
[*.{cmd,bat}]
end_of_line = crlf

# Docker
[{Dockerfile,docker-compose.yml}]
indent_size = 2

# GitLab
[.gitlab-ci.yml]
indent_size = 2

# All files
[*]
insert_final_newline = true
indent_style = space

###############################
# Naming Conventions          #
###############################

# Symbols

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_symbols.types.applicable_kinds = class,struct,interface,enum,delegate,type_parameter
dotnet_naming_symbols.types.applicable_accessibilities = *

dotnet_naming_symbols.members.applicable_kinds = property,method,event,local_function
dotnet_naming_symbols.members.applicable_accessibilities = *

dotnet_naming_symbols.constants.applicable_kinds = field,local
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_symbols.internal_static_fields.applicable_kinds = field
dotnet_naming_symbols.internal_static_fields.applicable_accessibilities = internal,private,protected,protected_internal,private_protected
dotnet_naming_symbols.internal_static_fields.required_modifiers = static

dotnet_naming_symbols.internal_fields.applicable_kinds = field
dotnet_naming_symbols.internal_fields.applicable_accessibilities = internal,private,protected,protected_internal,private_protected

dotnet_naming_symbols.public_fields.applicable_kinds = field
dotnet_naming_symbols.public_fields.applicable_accessibilities = public

dotnet_naming_symbols.local_scope_variables.applicable_kinds = parameter,local
dotnet_naming_symbols.local_scope_variables.applicable_accessibilities = *

# Styles

dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.start_with_I.required_prefix = I
dotnet_naming_style.start_with_I.capitalization = pascal_case

dotnet_naming_style.start_with_underscore.required_prefix = _
dotnet_naming_style.start_with_underscore.capitalization = camel_case

dotnet_naming_style.start_with_s_underscore.required_prefix = s_
dotnet_naming_style.start_with_s_underscore.capitalization = camel_case

# Rules

dotnet_naming_rule.interfaces_start_with_I.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_I.style = start_with_I
dotnet_naming_rule.interfaces_start_with_I.severity = default

dotnet_naming_rule.types_are_capitalized.symbols = types
dotnet_naming_rule.types_are_capitalized.style = pascal_case
dotnet_naming_rule.types_are_capitalized.severity = default

dotnet_naming_rule.members_are_capitalized.symbols = members
dotnet_naming_rule.members_are_capitalized.style = pascal_case
dotnet_naming_rule.members_are_capitalized.severity = default

dotnet_naming_rule.constants_are_capitalized.symbols = constants
dotnet_naming_rule.constants_are_capitalized.style = pascal_case
dotnet_naming_rule.constants_are_capitalized.severity = default

dotnet_naming_rule.internal_static_fields_start_with_s_underscore.symbols = internal_static_fields
dotnet_naming_rule.internal_static_fields_start_with_s_underscore.style = start_with_s_underscore
dotnet_naming_rule.internal_static_fields_start_with_s_underscore.severity = default

dotnet_naming_rule.internal_fields_start_with_underscore.symbols = internal_fields
dotnet_naming_rule.internal_fields_start_with_underscore.style = start_with_underscore
dotnet_naming_rule.internal_fields_start_with_underscore.severity = default

dotnet_naming_rule.public_fields_are_capitalized.symbols = public_fields
dotnet_naming_rule.public_fields_are_capitalized.style = pascal_case
dotnet_naming_rule.public_fields_are_capitalized.severity = default

dotnet_naming_rule.local_scope_variables_are_camel_case.symbols = local_scope_variables
dotnet_naming_rule.local_scope_variables_are_camel_case.style = camel_case
dotnet_naming_rule.local_scope_variables_are_camel_case.severity = default

# auto-generated


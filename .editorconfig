# Language rules
# ===================

# 'this.' and 'Me.' qualifiers
dotnet_style_qualification_for_field = false # Prefer fields not to be prefaced with `this.` or `Me.`
dotnet_style_qualification_for_property = false # Prefer properties not to be prefaced with `this.` or `Me.`.
dotnet_style_qualification_for_method = false # Prefer methods not to be prefaced with `this.` or `Me.`.
dotnet_style_qualification_for_event = false # Prefer events not to be prefaced with `this.` or `Me.`.

# 'var' preferences
csharp_style_var_for_built_in_types = true # Prefer `var` is used to declare variables with built-in system types such as `int`
csharp_style_var_when_type_is_apparent = true # Prefer `var` when the type is already mentioned on the right-hand side of a declaration expression
csharp_style_var_elsewhere = true # Prefer `var` over explicit type in all cases, unless overridden by another code style rule

# code-block preferences
csharp_prefer_braces = when_multiline # Prefer curly braces on multiple lines
csharp_style_namespace_declarations = file_scoped # Namespace declarations should be file scoped.
csharp_style_prefer_method_group_conversion = true # Prefer to convert a lambda expression to a method group.
csharp_style_prefer_top_level_statements = true # Prefer top-level statements.
csharp_prefer_system_threading_lock = true # Prefer `System.Threading.Lock` locks

# expression-level preferences
csharp_style_throw_expression = true # Prefer to use `throw` expressions instead of `throw` statements
dotnet_style_object_initializer = true # Prefer objects to be initialized using object initializers when possible
csharp_style_inlined_variable_declaration = true # Prefer `out` variables to be declared inline in the argument list of a method call when possible
dotnet_style_collection_initializer = true # Prefer to use collection initializers.
dotnet_style_prefer_collection_expression = when_types_loosely_match # Prefer to use collection expressions even when types match loosely, for example, IEnumerable<int> list = new List<int>() { 1, 2 };. The targeted type must match the type on the right-hand side or be one of the following types: IEnumerable<T>, ICollection<T>, IList<T>, IReadOnlyCollection<T>, IReadOnlyList<T>.
dotnet_style_coalesce_expression = true # Prefer null-coalescing expressions.
dotnet_style_null_propagation = true # Prefer to use null-conditional operator when possible
dotnet_style_prefer_auto_properties = true # Prefer automatically implemented properties
dotnet_style_explicit_tuple_names = true # Prefer tuple names to ItemX properties
csharp_prefer_simple_default_expression = true # Prefer `default` over `default(T)`
dotnet_style_prefer_inferred_tuple_names = true # Prefer inferred tuple element names
dotnet_style_prefer_inferred_anonymous_type_member_names = true # Prefer inferred anonymous type member names
csharp_style_prefer_local_over_anonymous_function = true # Prefer local functions over anonymous functions
dotnet_style_prefer_is_null_check_over_reference_equality_method = true # Prefer `is null` check
csharp_style_deconstructed_variable_declaration = true # Prefer deconstructed variable declaration
dotnet_style_prefer_conditional_expression_over_assignment = true # Prefer assignments with a ternary conditional
dotnet_style_prefer_conditional_expression_over_return = true # Prefer return statements to use a ternary conditional
dotnet_style_prefer_compound_assignment = true # Prefer compound assignment expressions
csharp_style_prefer_index_operator = true # Prefer to use the `^` operator when calculating an index from the end of a collection
csharp_style_prefer_range_operator = true # Prefer to use the range operator `..` when extracting a "slice" of a collection
csharp_style_unused_value_expression_statement_preference = discard_variable # Prefer to assign an unused expression to a discard
visual_basic_style_unused_value_expression_statement_preference = unused_local_variable # Prefer to assign an unused expression to a local variable that's never used
dotnet_style_prefer_simplified_interpolation = true # Prefer simplified interpolated strings
dotnet_style_prefer_simplified_boolean_expressions = true # Prefer simplified conditional expressions
visual_basic_style_prefer_isnot_expression = true # Prefer to use the `IsNot` pattern, when possible
csharp_style_implicit_object_creation_when_type_is_apparent = true # Prefer target-typed `new` expressions when created type is apparent
dotnet_style_namespace_match_folder = true # Prefer namespace naming to match folder structure.
visual_basic_style_prefer_simplified_object_creation = true # Prefer simplified object creation form.
csharp_style_prefer_null_check_over_type_check = true # Prefer null check over type check.
csharp_style_prefer_tuple_swap = true # Prefer using a tuple to swap two values.
dotnet_style_prefer_foreach_explicit_cast_in_source = when_strongly_typed # Prefer explicit casts for strongly typed (generic) collections but not for legacy collections, such as xref:System.Collections.ArrayList.
csharp_style_prefer_utf8_string_literals = true # Prefer UTF-8 string literals to byte arrays.
csharp_style_prefer_unbound_generic_type_in_nameof = true # Prefer unbound generic type in `nameof` expression
csharp_style_prefer_implicitly_typed_lambda_expression = true # Prefer to use an implicitly typed lambda

# pattern matching preferences
csharp_style_pattern_matching_over_as_with_null_check = true # Prefer pattern matching over `as` expression with null-conditional member access.
csharp_style_pattern_matching_over_is_with_cast_check = true # Prefer pattern matching instead of `is` expressions with type casts.
csharp_style_prefer_switch_expression = true # Prefer to use a `switch` expression
csharp_style_prefer_pattern_matching = true # Prefer to use pattern matching constructs, when possible
csharp_style_prefer_not_pattern = true # Prefer to use the `not` pattern, when possible
csharp_style_prefer_extended_property_pattern = true # Prefer the extended property pattern.

# expression-bodied members
csharp_style_expression_bodied_constructors = true # Prefer expression bodies for constructors
csharp_style_expression_bodied_methods = true # Prefer expression bodies for methods
csharp_style_expression_bodied_operators = true # Prefer expression bodies for operators
csharp_style_expression_bodied_properties = true # Prefer expression bodies for properties
csharp_style_expression_bodied_indexers = true # Prefer expression bodies for indexers
csharp_style_expression_bodied_accessors = true # Prefer expression bodies for accessors
csharp_style_expression_bodied_lambdas = true # Prefer expression bodies for lambdas
csharp_style_expression_bodied_local_functions = true # Prefer expression bodies for local functions

# modifier preferences
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async
visual_basic_preferred_modifier_order = Partial,Default,Private,Protected,Public,Friend,NotOverridable,Overridable,MustOverride,Overloads,Overrides,MustInherit,NotInheritable,Static,Shared,Shadows,ReadOnly,WriteOnly,Dim,Const,WithEvents,Widening,Narrowing,Custom,Async
dotnet_style_require_accessibility_modifiers = for_non_interface_members # Prefer accessibility modifiers except for public interface members.
csharp_prefer_static_local_function = true # Prefer local functions to be marked `static`
csharp_style_prefer_readonly_struct = true # Prefer to make a struct `readonly` when all its fields are `readonly`.
csharp_style_prefer_readonly_struct_member = true # Prefer to make struct members `readonly`.
csharp_prefer_static_anonymous_function = true # Prefer anonymous functions to be marked `static`

# field preferences
dotnet_style_readonly_field = true # Prefer that private fields be marked `readonly` if they're only ever assigned inline or in a constructor

# parentheses preferences
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity # Prefer parentheses to clarify arithmetic operator precedence
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity # Prefer parentheses to clarify relational operator precedence
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity # Prefer parentheses to clarify other binary operator precedence
dotnet_style_parentheses_in_other_operators = never_if_unnecessary # Prefer to not have parentheses when other operator precedence is obvious

# language keywords instead of framework type names
dotnet_style_predefined_type_for_locals_parameters_members = true # Prefer the language keyword for local variables, method parameters, and class members
dotnet_style_predefined_type_for_member_access = true # Prefer the language keyword for member access expressions

# code block preferences
csharp_prefer_simple_using_statement = true # Prefer to use a `using` declaration
csharp_style_prefer_primary_constructors = true # Prefer to use primary constructors.

# `using` directive preferences
csharp_using_directive_placement = outside_namespace # Prefer `using` directives to be placed outside the namespace
file_header_template = unset # Do not require a file header.

# null-checking preferences
csharp_style_conditional_delegate_call = true # Prefer to use the conditional coalescing operator (`?.`) when invoking a lambda expression

# new-line preferences
dotnet_style_allow_multiple_blank_lines_experimental = true
csharp_style_allow_embedded_statements_on_same_line_experimental = true
csharp_style_allow_blank_lines_between_consecutive_braces_experimental = true
dotnet_style_allow_statement_immediately_after_block_experimental = true
csharp_style_allow_blank_line_after_colon_in_constructor_initializer_experimental = false
csharp_style_allow_blank_line_after_token_in_conditional_expression_experimental = false
csharp_style_allow_blank_line_after_token_in_arrow_expression_clause_experimental = false

# Formatting rules
# =====================

# Using directive options
dotnet_sort_system_directives_first = true # Sort `System.*` `using` directives alphabetically, and place them before other `using` directives.
dotnet_separate_import_directive_groups = false # Do not place a blank line between `using` directive groups.

# New-line options
csharp_new_line_before_open_brace = all # Require braces to be on a new line for all expressions ("Allman" style).
csharp_new_line_before_else = true # Place `else` statements on a new line.
csharp_new_line_before_catch = true # Place `catch` statements on a new line.
csharp_new_line_before_finally = true # Require `finally` statements to be on a new line after the closing brace.
csharp_new_line_before_members_in_object_initializers = true # Require members of object initializers to be on separate lines
csharp_new_line_before_members_in_anonymous_types = true # Require members of anonymous types to be on separate lines
csharp_new_line_between_query_expression_clauses = true # Require elements of query expression clauses to be on separate lines

# Indentation options
csharp_indent_case_contents = true # Indent `switch` case contents
csharp_indent_switch_labels = true # Indent `switch` labels
csharp_indent_labels = one_less_than_current # Labels are placed at one less indent to the current context
csharp_indent_block_contents = true # Indent block contents.
csharp_indent_braces = false # Don't indent curly braces.
csharp_indent_case_contents_when_block = true # When it's a block, indent the statement list and curly braces for a case in a switch statement.

# Spacing options
csharp_space_after_cast = false # Remove space between the cast and the value
csharp_space_after_keywords_in_control_flow_statements = true # Place a space character after a keyword in a control flow statement such as a `for` loop
csharp_space_between_parentheses = false # Prefer no spaces between parentheses
csharp_space_before_colon_in_inheritance_clause = true # Place a space character before the colon for bases or interfaces in a type declaration
csharp_space_after_colon_in_inheritance_clause = true # Place a space character after the colon for bases or interfaces in a type declaration
csharp_space_around_binary_operators = before_and_after # Insert space before and after the binary operator
csharp_space_between_method_declaration_parameter_list_parentheses = false # Remove space characters after the opening parenthesis and before the closing parenthesis of a method declaration parameter list
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false # Remove space within empty parameter list parentheses for a method declaration
csharp_space_between_method_declaration_name_and_open_parenthesis = false # Remove space characters between the method name and opening parenthesis in the method declaration
csharp_space_between_method_call_parameter_list_parentheses = false # Remove space characters after the opening parenthesis and before the closing parenthesis of a method call
csharp_space_between_method_call_empty_parameter_list_parentheses = false # Remove space within empty argument list parentheses
csharp_space_between_method_call_name_and_opening_parenthesis = false # Remove space between method call name and opening parenthesis
csharp_space_after_comma = true # Insert space after a comma
csharp_space_before_comma = false # Remove space before a comma
csharp_space_after_dot = false # Remove space after a dot
csharp_space_before_dot = false # Remove space before a dot
csharp_space_after_semicolon_in_for_statement = true # Insert space after each semicolon in a `for` statement
csharp_space_before_semicolon_in_for_statement = false # Remove space before each semicolon in a `for` statement
csharp_space_around_declaration_statements = false # Remove extra space characters in declaration statements
csharp_space_before_open_square_brackets = false # Remove space before opening square brackets `[`
csharp_space_between_empty_square_brackets = false # Remove space between empty square brackets `[]`
csharp_space_between_square_brackets = false # Remove space characters in non-empty square brackets `[0]`

# Wrap options
csharp_preserve_single_line_statements = true # Leave statements and member declarations on the same line
csharp_preserve_single_line_blocks = true # Leave code block on single line

# Refactoring
dotnet_style_operator_placement_when_wrapping = beginning_of_line # Place operator on a new line.

# Unnecessary code rules
# ===========================

# expression-level preferences
csharp_style_unused_value_assignment_preference = discard_variable # Prefer to use a discard when assigning a value that's not used
visual_basic_style_unused_value_assignment_preference = unused_local_variable # Prefer to use a local variable when assigning a value that's not used

# parameter preferences
dotnet_code_quality_unused_parameters = all # Flag methods with any accessibility that contain unused parameters

# suppression preferences
dotnet_remove_unnecessary_suppression_exclusions = none # Enables the rule for all rules (no exclusions)

# auto-generated

###############
# Overrides   #
###############

[tests/**{Facts,Tests}*.cs]
dotnet_diagnostic.CA1034.severity = none # Nested types should not be visible
dotnet_diagnostic.CA1052.severity = none # Static holder types should be sealed
dotnet_diagnostic.CA1506.severity = none # Avoid excessive class coupling
dotnet_diagnostic.CA1707.severity = none # Identifiers should not contain underscores
dotnet_diagnostic.CA1861.severity = none # Avoid constant arrays as arguments
dotnet_diagnostic.CA2326.severity = none # Do not use TypeNameHandling values other than None
dotnet_diagnostic.CA2327.severity = none # Do not use insecure JsonSerializerSettings
dotnet_diagnostic.VO2006.severity = none # Methods should be sorted in alphabetical order

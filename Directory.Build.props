<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Properties for all projects -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>-</Description>
    <Product>ViciOne</Product>
    <Company>ViciOne open automation gmbh</Company>
    <Year>$([System.DateTime]::Now.Year)</Year>
    <Copyright>Copyright © $(Company) $(Year)</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NoBuild)' == 'true'">
    <!-- Pack should use already-built outputs of references -->
    <BuildProjectReferences>false</BuildProjectReferences>
  </PropertyGroup>

  <!-- Properties for repos that are published as NuGet packages -->
  <PropertyGroup>
    <Authors>$(Company)</Authors>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('src'))">
    <None Include="$(MSBuildThisFileDirectory)LICENSE.txt" Pack="true" PackagePath=""/>
  </ItemGroup>

  <!-- Optimizations for CI pipelines -->
  <PropertyGroup Condition="'$(CI)' != ''">
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
    <RunAnalyzers>true</RunAnalyzers>
  </PropertyGroup>

  <!-- Suppress CPM warning #440 -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>

  <!-- Properties for test projects -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests')) And $(MSBuildProjectDirectory.Contains('tests'))">
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner> <!-- Microsoft Testing Platform command line experience -->
  </PropertyGroup>

  <!-- Shared Microsoft Testing Platform configuration (e.g. code coverage settings); only picked up from the output directory -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests')) And $(MSBuildProjectDirectory.Contains('tests'))">
    <None Include="$(MSBuildThisFileDirectory)testconfig.json"
          Link="testconfig.json"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="$(AssemblyName).testconfig.json" />
  </ItemGroup>

  <!-- Properties for sample projects -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('samples'))">
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
</Project>

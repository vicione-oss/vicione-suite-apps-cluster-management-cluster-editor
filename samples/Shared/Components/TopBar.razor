@using Shared.Persistence.Components
@using Shared.Settings.Components
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums
@using LocalTechnicalTerms = Shared.Localization.Resources.TechnicalTerms

<div class="top-bar">
    <div class="title">Vici<span class="text-accent">O</span>ne - ClusterEditor Sample App</div>
    <div class="buttons-container">
        <button @onclick="OnSettingsClicked" title="@CommonVocabulary.SettingPlural">
            <MonochromeIcon Name="MonochromeIconName.GearLight" Size="MonochromeIconSize.SmallMedium"/>
        </button>
        <button @onclick="OnPersistenceClicked" title="@LocalTechnicalTerms.Persistence">
            <MonochromeIcon Name="MonochromeIconName.SaveOutline" Size="MonochromeIconSize.SmallMedium" />
        </button>
        <button @onclick="OnDebugClicked" title="Debug">
            <MonochromeIcon Name="MonochromeIconName.BugLight" Size="MonochromeIconSize.SmallMedium" />
        </button>
    </div>
</div>

<SettingsDialog @ref="_refSettingsDialog" />
<PersistenceDialog @ref="_refPersistenceDialog" />

@using ViciOne.Ui.Blazor.Components.Button
@using ViciOne.Ui.Blazor.Components.Button.Enums

<div class="section-header">
    File
</div>
<div class="section">
    <div>
        1:
        <Button OnClick="@(() => OnFileSaveClick(1))"
                Size="@ButtonSize.Small"
                Text="Save" />

        <Button OnClick="@(() => OnFileLoadClick(1))"
                Size="@ButtonSize.Small"
                Text="Load" />

        <Button OnClick="@(() => OnFileClearClick(1))"
                Size="@ButtonSize.Small"
                Text="Clear" />

        <span class="file-size">
            @(_fileSizes[0] < 0 ? $"(empty)" : $"({_fileSizes[0]} KB)")
        </span>
    </div>
    <div>
        2:
        <Button OnClick="@(() => OnFileSaveClick(2))"
                Size="@ButtonSize.Small"
                Text="Save" />

        <Button OnClick="@(() => OnFileLoadClick(2))"
                Size="@ButtonSize.Small"
                Text="Load" />

        <Button OnClick="@(() => OnFileClearClick(2))"
                Size="@ButtonSize.Small"
                Text="Clear" />

        <span class="file-size">
            @(_fileSizes[1] < 0 ? $"(empty)" : $"({_fileSizes[1]} KB)")
        </span>
    </div>
    <div>
        3:
        <Button OnClick="@(() => OnFileSaveClick(3))"
                Size="@ButtonSize.Small"
                Text="Save" />

        <Button OnClick="@(() => OnFileLoadClick(3))"
                Size="@ButtonSize.Small"
                Text="Load" />

        <Button OnClick="@(() => OnFileClearClick(3))"
                Size="@ButtonSize.Small"
                Text="Clear" />

        <span class="file-size">
            @(_fileSizes[2] < 0 ? $"(empty)" : $"({_fileSizes[2]} KB)")
        </span>
    </div>
</div>
<div class="section-header">
    Current Cluster
</div>
<div class="section">
    <Button OnClick="@(() => OnFileClearClick(4))"
            Size="@ButtonSize.Small"
            Text="Clear saved cluster" />

    <Button OnClick="IndexService.AddContainersAndRefresh"
            Size="@ButtonSize.Small"
            Text="Generate and Reload" />
</div>
<div class="section-header">
    Import Cluster
</div>
<div class="section">
    <InputFile OnChange="OnFileUpload">
        Import
    </InputFile>
</div>

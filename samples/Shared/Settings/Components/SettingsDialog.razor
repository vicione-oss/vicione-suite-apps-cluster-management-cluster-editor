@using Shared.Settings.Services

<Dialog @ref="_refDialog"
        HeaderText="@CommonVocabulary.SettingPlural"
        Height="505px"
        OnShowing="@OnDialogShowing"
        Width="150px">

    <Body>
        <div class="settings-container">

            <div class="heading">
                @CommonVocabulary.General
            </div>

            <div class="label">
                @CommonVocabulary.Language
            </div>

            <ComboBox @bind-Value="_settings.CurrentCultureName"
                      Items="@Services.SettingsService.SupportedCultureNames"
                      TextSelector="@(item => item)"
                      ValueSelector="@(item => item)" />

            <div class="label">
                @Localization.SettingsDialog.ShowDefaultContextMenu
            </div>
            <Switch @bind-Value:get="_settings.ShowDefaultContextMenu"
                    @bind-Value:set="OnShowDefaultContextMenuChanged" />

            <div class="heading">
                Cluster Editor
            </div>

            <div class="label">
                @Localization.SettingsDialog.GridMode
            </div>
            <ComboBox @bind-Value="_settings.GridMode"
                      Items="@GridModeComboBoxItemsFactory.GridModeComboBoxItems"
                      TextSelector="@(item => item.Text)"
                      ValueSelector="@(item => item.Value)" />

            <div class="label">
                @Localization.SettingsDialog.UseGimpPanBehavior
            </div>
            <Switch @bind-Value="@_settings.PanBehavior" />

            <div class="label">
                @Localization.SettingsDialog.UseSimplifiedView
            </div>
            <Switch @bind-Value="@_settings.SimplifiedView" />

            <div class="label">
                @Localization.SettingsDialog.NodeAlignmentBorderVisible
            </div>
            <Switch @bind-Value="@_settings.NodeAlignmentBorder" />

            <div class="label">
                @Localization.SettingsDialog.UseMinimapColoring
            </div>
            <Switch @bind-Value="@_settings.MinimapNodeColoring" />
        </div>
    </Body>

    <Footer>
        <DialogFooterButton OnClick="@OnDialogSave"
                            Text="@CommonVocabulary.Save" />

        <DialogFooterButton OnClick="@OnDialogCancel"
                            Text="@CommonVocabulary.Cancel" />
    </Footer>
</Dialog>

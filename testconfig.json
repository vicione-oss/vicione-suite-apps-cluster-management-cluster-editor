{
    "codeCoverage": {
        "Configuration": {
            "CodeCoverage": {
                "Attributes": {
                    "Exclude": {
                        "Attribute": [
                            "^System\\.CodeDom\\.Compiler\\.GeneratedCodeAttribute$",
                            "^System\\.Diagnostics\\.CodeAnalysis\\.ExcludeFromCodeCoverageAttribute$"
                        ]
                    }
                },
                "ModulePaths": {
                    "Exclude": {
                        "ModulePath": [
                            "*Client*",
                            "*Server*",
                            "*Shared*",
                            ".*Facts.dll",
                            ".*Tests.dll"
                        ]
                    }
                }
            }
        }
    }
}

<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
    <RunConfiguration>
        <ResultsDirectory>artifacts/tests</ResultsDirectory>
    </RunConfiguration>
    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector friendlyName="XPlat Code Coverage">
                <Configuration>
                    <!-- Für die Ermittlung der Codeabdeckung mit Coverlet kann folgende Anleitung verwendet werden: https://github.com/tonerdo/coverlet#vstest-integration-preferred-due-to-known-issue -->
                    <Format>json,opencover,cobertura</Format>
                    <MergeWith>../../artifacts/tests/coverage.json</MergeWith>
                    <Exclude>[*Test*]*,[*Fact*]*, [Shared*]*, [*Client*]*, [Server*]*, [*]*Generat*</Exclude>
                    <ExcludeByAttribute>CompilerGenerated</ExcludeByAttribute>
                    <IncludeTestAssembly>false</IncludeTestAssembly>
                </Configuration>
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
</RunSettings>

@using System.Globalization
@using ViciOne.Ui.Blazor.Components.SectionRail.Components
@using ViciOne.Ui.Blazor.Components.SectionRail.Components.ActionButtons
@using ViciOne.Ui.ClusterEditor.Sections.DataPorts.ContextMenu
@using ViciOne.Ui.Localization.Resources
@using TechnicalTerms=ViciOne.Ui.ClusterEditor.Localization.Resources.TechnicalTerms
@using CommonVocabulary=ViciOne.Ui.Localization.Resources.CommonVocabulary

<SectionLayout>
    <ActionButtons>
        <SectionActionButton IconCssClass="@_plusIconCssClass"
                             OnClick="@OnAddDataPortClickedAsync"
                             Title="@Localization.DataPortSection.NewDataPort" />
    </ActionButtons>

    <Tools>
        <SearchAndFilterComponent GroupingButtonsEnabled="@_groupingButtonsEnabled"
                                  OnCollapseAllGroups="@OnCollapseAllGroups"
                                  OnExpandAllGroups="@OnExpandAllGroups"
                                  OnSearchTextChanged="@OnFilterTextChanged"
                                  ShowColumnChooser="false" />

        <div class="added-while-filtered-info">
            @if (_elementsAddedWhileFiltered > 0)
            {
                <span>@string.Format(Localization.DataPortSection.ElementAddedWhileFilteredInfo, _elementsAddedWhileFiltered)</span>
            }
        </div>
    </Tools>

    <Content>
        <div class="content-container">
            <CascadingValue IsFixed="true"
                            Value="@_editTemplateContext">

                <TreeEditor Builder="@_treeBuilder"
                            ShowGuidelines="true"
                            TemplateMapping="@(OnTreeEditorTemplateMapping)" />
            </CascadingValue>
        </div>
    </Content>
</SectionLayout>

<AddDataPortContextMenu OnContextMenuItemClick="@OnAddDataPortContextMenuItemClick" />

<DataPortAddChildNodeContextMenu OnContextMenuItemClick="@(eventArgs => OnPossibleChildNodeClicked(eventArgs.ParentNode, eventArgs.PossibleChild))" />

<DxDialog @ref="_confirmDeleteDialogRef"
          CloseOnEscape="true"
          CloseOnOutsideClick="false"
          Header="@(string.Format(CultureInfo.CurrentCulture, UserActions.DeleteSomething, TechnicalTerms.Node))"
          Height="@DialogSizes.SmallHeight"
          Width="@DialogSizes.SmallWidth">
    <Body>
        <div class="confirm-node-delete-text">@Localization.DataPortSection.ConfirmDeleteNode</div>
    </Body>

    <Footer>
        <DxDialogFooterButton OnClick="@OnDeleteNodeConfirmAsync"
                                Text="@CommonVocabulary.Yes" />

        <DxDialogFooterButton OnClick="@OnDeleteNodeCancelAsync"
                                Text="@CommonVocabulary.No" />
    </Footer>
</DxDialog>

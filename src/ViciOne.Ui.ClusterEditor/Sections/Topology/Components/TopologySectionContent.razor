@using System.Globalization
@using ViciOne.Ui.Blazor.Components.SectionRail.Components
@using ViciOne.Ui.Blazor.Components.SectionRail.Components.ActionButtons
@using ViciOne.Ui.Localization.Resources
@using TechnicalTerms=ViciOne.Ui.ClusterEditor.Localization.Resources.TechnicalTerms
@using CommonVocabulary=ViciOne.Ui.Localization.Resources.CommonVocabulary

<SectionLayout>
    <ActionButtons>
        <SectionActionButton IconCssClass="@_plusIconCssClass"
                             OnClick="@OnAddNodeGroupClicked"
                             Title="@Localization.TopologySection.AddClusterNodeGroup" />
    </ActionButtons>

    <Tools>
        <SearchAndFilterComponent GroupingButtonsEnabled="true"
                                  OnCollapseAllGroups="@OnCollapseAllGroups"
                                  OnExpandAllGroups="@OnExpandAllGroups"
                                  OnSearchTextChanged="@OnFilterTextChanged"
                                  ShowColumnChooser="false" />

        <div class="added-while-filtered-info">
            @if (_elementsAddedWhileFiltered > 0)
            {
                <span>@(string.Format(Localization.TopologySection.ElementAddedWhileFilteredInfo, _elementsAddedWhileFiltered))</span>
            }
        </div>
    </Tools>

    <Content>
        <div class="content-container">
            <CascadingValue IsFixed="true"
                            Value="@_editTemplateContext">

                <TreeEditor Builder="@_treeBuilder" />
            </CascadingValue>
        </div>
    </Content>
</SectionLayout>

<DxDialog @ref="_confirmDeleteDialogRef"
          CloseOnEscape="true"
          CloseOnOutsideClick="false"
          Header="@(string.Format(UserActions.DeleteSomething, TechnicalTerms.Node))"
          Height="@DialogSizes.SmallHeight"
          Width="@DialogSizes.SmallWidth">
    <Body>
        <div class="confirm-node-delete-text">@Localization.TopologySection.ConfirmDeleteNode</div>
    </Body>

    <Footer>
        <DxDialogFooterButton OnClick="@OnDeleteNodeConfirmAsync"
                              Text="@CommonVocabulary.Yes" />

        <DxDialogFooterButton OnClick="@OnDeleteNodeCancelAsync"
                              Text="@CommonVocabulary.No" />
    </Footer>
</DxDialog>

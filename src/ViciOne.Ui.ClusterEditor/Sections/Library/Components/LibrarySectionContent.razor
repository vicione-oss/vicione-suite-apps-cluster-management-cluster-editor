@using ViciOne.Ui.Blazor.Components.SectionRail.Components
@using ViciOne.Ui.Blazor.Components.SectionRail.Components.ActionButtons

<SectionLayout>
    <ActionButtons>
        <SectionActionButton IconCssClass="@_openIconCssClass"
                             OnClick="@OnImportFbDesignsClicked"
                             Title="@Localization.LibrarySection.LoadFbDesignsTooltip" />
    </ActionButtons>

    <Tools>
        <SearchAndFilterComponent @bind-SearchText="_searchText"
                                  @bind-SearchText:after="FilterNodes"
                                  GroupingButtonsEnabled="true"
                                  OnCollapseAllGroups="@OnCollapseAllGroups"
                                  OnExpandAllGroups="@OnExpandAllGroups"
                                  ShowColumnChooser="false" />
    </Tools>

    <Content>
        <TreeEditor Builder="@_treeBuilder" />
    </Content>
</SectionLayout>

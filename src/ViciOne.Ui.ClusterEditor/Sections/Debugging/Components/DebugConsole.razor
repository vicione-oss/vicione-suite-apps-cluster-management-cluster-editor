@{
    #if DEBUG
    {
        <div class="debug-console">
            <div class="values"
                 style="--dbg-log-height:@(Razor.GetCssPx(DebugService.VisualLogHeightPx));">

                @if (DebugService.ShowMessageLog)
                {
                    foreach (var msg in DebugService.GetLog())
                    {
                        <div class="log-message">
                                <div class="msg-info"
                                     title="@($"{msg.CallerFilePath} >> {msg.CallerMemberName} : {msg.CallerLineNumber}")">
                                </div>

                                <div class="msg"
                                    title="@msg.Message">

                                @msg.Message
                                </div>
                        </div>
                    }
                }
                else
                {
                    foreach (var kv in DebugService.GetKeyValuePairs())
                    {
                        <div class="kv-pair"
                             title="@(string.Join(Environment.NewLine, DebugService.GetValueHistory(kv.Key)))">

                            <span class="key">@kv.Key</span>
                            <span class="value">@kv.Value</span>
                        </div>
                    }
                }
            </div>

            <div class="actions">
                <button @onclick="@ToggleDebugLog"
                        class="action-btn">

                    Toggle log
                </button>

                <input @onchange="@((e) => SetDbgHeightPx(Convert.ToInt32(e.Value)))"
                       class="log-height"
                       title="The hight of the log in pixels"
                       type="number"
                       value="@DebugService.VisualLogHeightPx" />

                @foreach (var action in DebugService.GetActions())
                {
                    <button @onclick="action.Value"
                            class="action-btn">

                        @action.Key
                    </button>
                }
            </div>
        </div>
    }
    #endif
}

@using ViciOne.Ui.Blazor.Components.SectionRail.Components
@using ViciOne.Ui.Blazor.Components.Tables.AdvancedTable.Components.ColumnChooser
@using ViciOne.Ui.Blazor.Components.Tables.AdvancedTable.Components.Footers
@using ViciOne.Ui.Blazor.Components.Tables.Shared.Enums
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components.Columns
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components.Filters
@using ViciOne.Ui.ClusterEditor.Models.Comparer
@using CommonVocabulary = ViciOne.Ui.Localization.Resources.CommonVocabulary
@using SelectionMode = ViciOne.Ui.Blazor.Components.Tables.Shared.Enums.SelectionMode

<SectionLayout>
    <Tools>
        <SearchAndFilterComponent @bind-SearchText:get="_searchText"
                                  @bind-SearchText:set="SearchTextChanged"
                                  FilterButtons="@_filterButtons"
                                  ShowGroupingButtons="false">

            @* The toggle renders no button of its own, so the slot supplies one. *@
            <ColumnChooserSlot>
                <ColumnChooserToggle Id="@_columnChooserToggleId"
                                     OpenPopupToLeft="true">

                    <Button>
                        <div @onclick="@context.Toggle"
                             class="column-chooser-button @(context.PopupVisible ? "active" : string.Empty)"
                             title="@context.PopupTitle">

                            <MonochromeIcon Name="MonochromeIconName.ColumnChooserMenu"
                                            Size="MonochromeIconSize.SmallMedium" />
                        </div>
                    </Button>
                </ColumnChooserToggle>
            </ColumnChooserSlot>
        </SearchAndFilterComponent>
    </Tools>

    <Content>
        <div class="content-container">
            <PublishedConnectorDragGhost @ref="_dragGhost" />

            <SimpleTable TItem="DataGridConnectorWrapper"
                         ColumnChooserToggleId="@_columnChooserToggleId"
                         @bind-SelectedItems="_selectedItems"
                         @bind-FilterState="_filterState"
                         DragPayloadProvider="VisibleSelection"
                         ItemSelectionAllowed="@SelectionAllowed"
                         Items="@PublishedConnectorsService.PublishedConnectorWrappers"
                         MaximumHeight="100%"
                         Mode="TableLoadingMode.Virtualize"
                         RowContextMenuRequested="@_rowContextMenu"
                         RowDoubleClick="RowDoubleClick"
                         RowsDraggable="true"
                         SelectionMode="SelectionMode.Multiple"
                         SortingState="_initialSorting"
                         VisibleSelectionChanged="VisibleSelection.Store">
                <Columns>
                    <SimpleTableTemplateColumn TItem="DataGridConnectorWrapper"
                                               CellActivated="RowDoubleClick"
                                               Id="@nameof(DataGridConnectorWrapper.Path)"
                                               Resizeable="true"
                                               Title="@CommonVocabulary.Path"
                                               Width="110">
                        <CellContent>
                            <div class="text-truncated" title="@context.Path">
                                <SearchHighlighter SearchText="@_searchText" Text="@context.Path" />
                            </div>
                        </CellContent>
                        <FilterEditor>
                            <SimpleTableContainsColumnFilterEditor TItem="DataGridConnectorWrapper"
                                                                   ValueSelector="x => x.Path" />
                        </FilterEditor>
                    </SimpleTableTemplateColumn>

                    <SimpleTableTemplateColumn TItem="DataGridConnectorWrapper"
                                               CellActivated="RowDoubleClick"
                                               Id="@nameof(DataGridConnectorWrapper.DesignName)"
                                               Resizeable="true"
                                               SortExpression="s_designNameSortExpression"
                                               Title="@CommonVocabulary.Design"
                                               Width="140">
                        <CellContent>
                            <div class="text-truncated" title="@context.DesignName">
                                <SearchHighlighter SearchText="@_searchText" Text="@context.DesignName" />
                            </div>
                        </CellContent>
                        <FilterEditor>
                            <SimpleTableContainsColumnFilterEditor TItem="DataGridConnectorWrapper"
                                                                   ValueSelector="x => x.DesignName" />
                        </FilterEditor>
                    </SimpleTableTemplateColumn>

                    <SimpleTableTemplateColumn TItem="DataGridConnectorWrapper"
                                               CellActivated="RowDoubleClick"
                                               Id="@nameof(DataGridConnectorWrapper.FunctionBlockName)"
                                               Resizeable="true"
                                               SortComparer="AlphaNumericComparer.Default"
                                               SortExpression="s_functionBlockNameSortExpression"
                                               Title="@TechnicalTerms.FunctionBlock"
                                               Width="140">
                        <CellContent>
                            <div class="text-truncated" title="@context.FunctionBlockName">
                                <SearchHighlighter SearchText="@_searchText" Text="@context.FunctionBlockName" />
                            </div>
                        </CellContent>
                        <FilterEditor>
                            <SimpleTableContainsColumnFilterEditor TItem="DataGridConnectorWrapper"
                                                                   ValueSelector="x => x.FunctionBlockName" />
                        </FilterEditor>
                    </SimpleTableTemplateColumn>

                    <SimpleTableTemplateColumn TItem="DataGridConnectorWrapper"
                                               CellActivated="RowDoubleClick"
                                               Id="@nameof(DataGridConnectorWrapper.ConnectorName)"
                                               Resizeable="true"
                                               Title="@TechnicalTerms.Connector"
                                               Width="125">
                        <CellContent>
                            <div class="connector-with-icon-cell">
                                <div class="icon">
                                    @GetIconMarkup(context)
                                </div>
                                <div class="value">
                                    <SearchHighlighter SearchText="@_searchText" Text="@context.ConnectorName" />
                                </div>
                            </div>
                        </CellContent>
                        <FilterEditor>
                            <SimpleTableContainsColumnFilterEditor TItem="DataGridConnectorWrapper"
                                                                   ValueSelector="x => x.ConnectorName" />
                        </FilterEditor>
                    </SimpleTableTemplateColumn>

                    <SimpleTableTemplateColumn TItem="DataGridConnectorWrapper"
                                               CellActivated="RowDoubleClick"
                                               Id="@nameof(DataGridConnectorWrapper.Links)"
                                               Resizeable="true"
                                               Title="@TechnicalTerms.LinkPlural"
                                               Width="100">
                        <CellContent>
                            <div class="text-truncated" title="@context.Links">
                                <SearchHighlighter SearchText="@_searchText" Text="@context.LinksText" />
                            </div>
                        </CellContent>
                        <FilterEditor>
                            <SimpleTableContainsColumnFilterEditor TItem="DataGridConnectorWrapper"
                                                                   ValueSelector="x => x.LinksText" />
                        </FilterEditor>
                    </SimpleTableTemplateColumn>

                    <SimpleTableTemplateColumn TItem="DataGridConnectorWrapper"
                                               CellActivated="RowDoubleClick"
                                               Id="@nameof(DataGridConnectorWrapper.Description)"
                                               Resizeable="true"
                                               Title="@CommonVocabulary.Description"
                                               Width="160">
                        <CellContent>
                            <div class="text-truncated" title="@context.Description">
                                <SearchHighlighter SearchText="@_searchText" Text="@context.Description" />
                            </div>
                        </CellContent>
                        <FilterEditor>
                            <SimpleTableContainsColumnFilterEditor TItem="DataGridConnectorWrapper"
                                                                   ValueSelector="x => x.Description" />
                        </FilterEditor>
                    </SimpleTableTemplateColumn>
                </Columns>

                <Footer>
                    <TableFooter SelectedItemCount="VisibleSelection.Rows.Count" />
                </Footer>
            </SimpleTable>
        </div>
    </Content>
</SectionLayout>

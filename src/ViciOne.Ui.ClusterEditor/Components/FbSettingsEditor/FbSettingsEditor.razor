@using ViciOne.Ui.Blazor.Components.Dialog.Components
@using ViciOne.Ui.Blazor.Components.Tables.AdvancedTable.Components.ColumnChooser
@using ViciOne.Ui.Blazor.Components.Tables.AdvancedTable.Components.Footers
@using ViciOne.Ui.Blazor.Components.Tables.Shared.Enums
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components.Columns
@using ViciOne.Ui.Blazor.Components.Toolbar.Components
@using ViciOne.Ui.Blazor.Components.Toolbar.Enums
@using ViciOne.Ui.ClusterEditor.Components.ToolbarSearchbox
@using CommonVocabulary = ViciOne.Ui.Localization.Resources.CommonVocabulary
@using LocalTechnicalTerms = ViciOne.Ui.ClusterEditor.Localization.Resources.TechnicalTerms
@using TechnicalTerms = ViciOne.Ui.Localization.Resources.TechnicalTerms

@* CloseOnEscape="true" not supported yet, https://gitlab.com/vicione-oss/vicione/ui-libs/blazor-components/-/issues/141 *@
<Dialog @bind-Visible="_visible"
        @ref="_refDialog"
        HeaderText="@($"{LocalTechnicalTerms.FunctionBlock} - {CommonVocabulary.SettingPlural}")"
        Height="@(_isFullscreen ? DialogSizes.FullscreenHeight : DialogSizes.LargeHeight)"
        OnClosing="@OnDialogClosing"
        Width="@(_isFullscreen ? DialogSizes.FullscreenWidth : DialogSizes.LargeWidth)">

    <HeaderSlot>
        <Toolbar>
            <ToolbarGroup AlignRight="true">
                <ToolbarSearchbox Text="@_searchText"
                                  TextChanging="SearchTextChanging" />

                <ToolbarButton IconName="@MonochromeIconName.TemplateBadge"
                               Text="@Localization.FbSettingsEditor.ShowTemplatePlural"
                               TextVisibility="@TextVisibility.MenuOnly"
                               Visible="false" />

                <ToolbarButton IconName="@MonochromeIconName.TemplateManagement"
                               Text="@_editTemplatesText"
                               TextVisibility="@TextVisibility.MenuOnly"
                               Visible="false" />

                <ColumnChooserToggle Id="@_columnChooserToggleId"
                                     MaximumVisibleRowCount="15"
                                     OpenPopupToLeft="true">

                    <Button>
                        <ToolbarButton Active="@context.PopupVisible"
                                       IconName="@MonochromeIconName.ColumnChooserMenu"
                                       OnClick="@context.Toggle"
                                       Text="@context.PopupTitle"
                                       TextVisibility="@TextVisibility.MenuOnly" />
                    </Button>
                </ColumnChooserToggle>

                <ToolbarButton Active="@_isFullscreen"
                               IconName="@MonochromeIconName.FullSizeLight"
                               OnClick="@OnFullscreenButtonClicked"
                               Text="@TechnicalTerms.Fullscreen"
                               TextVisibility="@TextVisibility.MenuOnly" />
            </ToolbarGroup>
        </Toolbar>
    </HeaderSlot>

    <Body>
        <div class="content-container">
            <div class="content">
                <SimpleTable @bind-FilterState="_filterState"
                             ColumnChooserToggleId="@_columnChooserToggleId"
                             Items="@_settings"
                             MaximumHeight="100%"
                             Mode="TableLoadingMode.All"
                             RowClickSelectionEnabled="false"
                             TItem="IGrouping<string, FbSetting>">

                    <Columns>
                        <SimpleTableTemplateColumn Id="@NameColumnKey"
                                                   PinSide="PinSide.Left"
                                                   Resizeable="false"
                                                   ShowInColumnChooser="false"
                                                   TItem="IGrouping<string, FbSetting>"
                                                   Title="@CommonVocabulary.Name"
                                                   Width="240">

                            <CellContent>
                                <span>
                                    <SearchHighlighter SearchText="@_searchText"
                                                       Text="@context.Key" />
                                </span>
                            </CellContent>
                        </SimpleTableTemplateColumn>

                        @if (_settings.Count > 0 && _settings[0].Count() > 1)
                        {
                            <SimpleTableTemplateColumn CellActivated="@(settingGroup => CellActivated(AllColumnKey, settingGroup))"
                                                       Id="@AllColumnKey"
                                                       MinimumWidth="128"
                                                       PinSide="PinSide.Left"
                                                       Resizeable="false"
                                                       ShowInColumnChooser="false"
                                                       TItem="IGrouping<string, FbSetting>"
                                                       Title="@CommonVocabulary.All">

                                <CellContent>
                                    @{
                                        var allSetting = GetSetting(AllColumnKey, context);
                                    }

                                    <Cell Activated="@IsCellActivated(AllColumnKey, context)"
                                          JsModule="@_cellModule"
                                          Modified="@IsAnySettingModified(context)"
                                          OnValueCommitted="@(value => CellValueCommitted(AllColumnKey, context, value))"
                                          SearchText="@_searchText"
                                          Setting="@allSetting.Setting"
                                          Value="@GetCellValue(AllColumnKey, context)"
                                          ValueType="@allSetting.SettingType" />
                                </CellContent>
                            </SimpleTableTemplateColumn>
                        }

                        @if (_settings.Count > 0)
                        {
                            @foreach (var columnSetting in _settings[0])
                            {
                                var fbName = columnSetting.FbName;

                                <SimpleTableTemplateColumn CellActivated="@(settingGroup => CellActivated(fbName, settingGroup))"
                                                           Id="@fbName"
                                                           MinimumWidth="128"
                                                           Resizeable="false"
                                                           TItem="IGrouping<string, FbSetting>"
                                                           Title="@fbName">

                                    <CellContent>
                                        @{
                                            var setting = GetSetting(fbName, context);
                                        }

                                        <Cell Activated="@IsCellActivated(fbName, context)"
                                              JsModule="@_cellModule"
                                              Modified="@setting.IsModified"
                                              OnValueCommitted="@(value => CellValueCommitted(fbName, context, value))"
                                              SearchText="@_searchText"
                                              Setting="@setting.Setting"
                                              Value="@setting.Value"
                                              ValueType="@setting.SettingType" />
                                    </CellContent>
                                </SimpleTableTemplateColumn>
                            }
                        }

                        <SimpleTableTemplateColumn Id="@CommentColumnKey"
                                                   PinSide="PinSide.Right"
                                                   Resizeable="false"
                                                   ShowInColumnChooser="false"
                                                   TItem="IGrouping<string, FbSetting>"
                                                   Title="@CommonVocabulary.Comment"
                                                   Width="328">

                            @* Comments are not stored on a setting yet, so the column is a placeholder. *@
                            <CellContent></CellContent>
                        </SimpleTableTemplateColumn>
                    </Columns>

                    <Footer>
                        <TableFooter />
                    </Footer>
                </SimpleTable>
            </div>
        </div>
    </Body>

    <Footer>
        <DialogFooterButton OnClick="@OnDialogOk"
                            Text="@CommonVocabulary.Ok" />

        <DialogFooterButton OnClick="@OnClose"
                            Text="@CommonVocabulary.Cancel" />
    </Footer>
</Dialog>

@using ViciOne.Ui.Blazor.Components.CheckBox
@using ViciOne.Ui.Blazor.Components.Dialog.Components
@using ViciOne.Ui.Blazor.Components.SearchBox
@using ViciOne.Ui.Blazor.Components.Toolbar.Components
@using ViciOne.Ui.Blazor.Components.Toolbar.Enums
@using ViciOne.Ui.ClusterEditor.Components.ToolbarColumnChooserButton
@using ViciOne.Ui.ClusterEditor.Components.UniversalInput
@using CommonVocabulary = ViciOne.Ui.Localization.Resources.CommonVocabulary
@using LocalTechnicalTerms = ViciOne.Ui.ClusterEditor.Localization.Resources.TechnicalTerms
@using TechnicalTerms = ViciOne.Ui.Localization.Resources.TechnicalTerms

@* CloseOnEscape="true" not supported yet, https://gitlab.com/vicione-oss/vicione/ui-libs/blazor-components/-/issues/141 *@
<Dialog @bind-Visible="_visible"
        @ref="@_refDialog"
        HeaderText="@($"{LocalTechnicalTerms.FunctionBlock} - {CommonVocabulary.SettingPlural}")"
        Height="@(_isFullscreen ? DialogSizes.FullscreenHeight : DialogSizes.LargeHeight)"
        OnClosing="@OnDialogClosing"
        OnShowing="@OnDialogShowing"
        Width="@(_isFullscreen ? DialogSizes.FullscreenWidth : DialogSizes.LargeWidth)">

    <HeaderSlot>
        <Toolbar>
            <ToolbarGroup AlignRight="true">
                <ToolbarContent>
                    <div class="search-container">
                        <SearchBox Placeholder="@CommonVocabulary.Search"
                                   Text="@_searchText"
                                   TextChanging="OnSearchTextChanging" />
                    </div>
                </ToolbarContent>

                <ToolbarButton IconName="@MonochromeIconName.TemplateBadge"
                               Text="@Localization.FbSettingsEditor.ShowTemplatePlural"
                               TextVisibility="@TextVisibility.MenuOnly"
                               Visible="false" />

                <ToolbarButton IconName="@MonochromeIconName.TemplateManagement"
                               Text="@_editTemplatesText"
                               TextVisibility="@TextVisibility.MenuOnly"
                               Visible="false" />

                <ToolbarColumnChooserButton AssociatedGrid="@_refGrid" />

                <ToolbarButton Active="@_isFullscreen"
                               IconName="@MonochromeIconName.FullSizeLight"
                               OnClick="@OnFullscreenButtonClicked"
                               Text="@TechnicalTerms.Fullscreen"
                               TextVisibility="@TextVisibility.MenuOnly" />
            </ToolbarGroup>
        </Toolbar>
    </HeaderSlot>

    <Body>
        <div class="content-container">
            <div class="content">
                <DxGrid @ref="_refGrid"
                        AllowGroup="false"
                        AllowSort="false"
                        ColumnResizeMode="GridColumnResizeMode.Disabled"
                        CssClass="dialog-grid"
                        CustomizeEditModel="@OnCustomizeEditModel"
                        Data="_settings"
                        EditCanceling="@OnGridEditCancelling"
                        EditMode="@GridEditMode.EditCell"
                        EditModelSaving="@OnGridEditModelSaving"
                        EditStart="@OnGridEditStart"
                        SearchText="@_searchText"
                        SearchTextParseMode="GridSearchTextParseMode.ExactMatch"
                        ShowAllRows="true"
                        UnboundColumnData="@OnUnboundColumnData">
                    <Columns>

                        <DxGridDataColumn Caption="@CommonVocabulary.Name"
                                          DataRowEditorVisible="false"
                                          FieldName="@NameColumnKey"
                                          FixedPosition="GridColumnFixedPosition.Left"
                                          ShowInColumnChooser="false"
                                          VisibleIndex="1"
                                          Width="240px">

                            <CellEditTemplate Context="cetCtx">
                                <span>
                                    @(((IGrouping<string, FbSetting>)cetCtx.DataItem).Key)
                                </span>
                            </CellEditTemplate>
                        </DxGridDataColumn>

                        <DxGridDataColumn Caption="@CommonVocabulary.All"
                                          FieldName="@AllColumnKey"
                                          FixedPosition="GridColumnFixedPosition.Left"
                                          ShowInColumnChooser="false"
                                          UnboundType="GridUnboundColumnType.Object"
                                          Visible="@(_settings.First().Count() > 1)"
                                          VisibleIndex="2"
                                          MinWidth="128">

                            <CellDisplayTemplate Context="cdtCtx">
                                @{
                                    var dataItem = (IGrouping<string, FbSetting>)cdtCtx.DataItem;
                                    var fbName = "All";
                                    var isAnySettingModified = IsAnySettingModified(dataItem);

                                    if (IsBooleanDataItem(dataItem, out var _))
                                    {
                                        var boolValue = (bool?)GetCellValue(fbName, dataItem);
                                        var AllowIndeterminateState = boolValue is null;

                                        <CheckBox Value="@boolValue"
                                                  ValueChanged="@(async (bool? value) => OnCheckedChanged(dataItem, value, fbName))"
                                                  AllowIndeterminateState="@AllowIndeterminateState" />
                                    }
                                    else
                                    {
                                        <span class="@(isAnySettingModified ? "modified" : "regular")">
                                            <ViciOne.Ui.Shared.Dx.Components.SearchHighlighter SearchText="@_searchText"
                                                                                               Text="@(GetCellValue(fbName, dataItem)?.ToString() ?? string.Empty)" />
                                        </span>
                                    }
                                }
                            </CellDisplayTemplate>

                            <CellEditTemplate Context="cetCtx">
                                @{
                                    var dataItem = (IGrouping<string, FbSetting>)cetCtx.DataItem;
                                    var fbName = cetCtx.DataColumn.FieldName;
                                    var setting = GetSetting(fbName, dataItem);

                                    if (IsBooleanDataItem(dataItem, out var isNullableBoolean))
                                    {
                                        var boolValue = (bool?)GetCellValue(fbName, dataItem);

                                        <CheckBox Value="@boolValue"
                                                  ValueChanged="@(async (bool? value) => OnCheckedChanged(dataItem, value, fbName))"
                                                  AllowIndeterminateState="@isNullableBoolean" />
                                    }
                                    else
                                    {
                                        <div class="input-container"
                                             @onfocusin="(_) => SetInitialValues(dataItem)"
                                             @onpointerdown:stopPropagation>

                                            <UniversalInput @bind-Value:get="@GetCellValue(fbName, dataItem)"
                                                            @bind-Value:set="@((e) => OnValueBindingSet(fbName, dataItem, e))"
                                                            ValueType="@setting.SettingType" />
                                        </div>

                                        <div class="validation-message-container">
                                            @if (!string.IsNullOrEmpty(_validationMessage))
                                            {
                                                <span title="@_validationMessage">
                                                    @_validationMessage
                                                </span>
                                            }
                                        </div>
                                    }
                                }
                            </CellEditTemplate>
                        </DxGridDataColumn>

                        @foreach (var setting in _settings.First())
                        {
                            <DxGridDataColumn Caption="@setting.FbName"
                                              FieldName="@setting.FbName"
                                              UnboundType="GridUnboundColumnType.String"
                                              MinWidth="128">

                                <CellDisplayTemplate Context="cdtCtx">
                                    @{
                                        var dataItem = (IGrouping<string, FbSetting>)cdtCtx.DataItem;
                                        var fbName = cdtCtx.DataColumn.FieldName;
                                        var setting = GetSetting(fbName, dataItem);

                                        if (IsBooleanDataItem(dataItem, out var isNullableBoolean))
                                        {
                                            var boolValue = (bool?)setting.Value;

                                            <CheckBox Value="@boolValue"
                                                      ValueChanged="@(async (bool? value) => OnCheckedChanged(dataItem, value, fbName))"
                                                      AllowIndeterminateState="@isNullableBoolean" />
                                        }
                                        else
                                        {
                                            <span class="@(setting.IsModified ? "modified" : "regular")">
                                                <ViciOne.Ui.Shared.Dx.Components.SearchHighlighter SearchText="@_searchText"
                                                                                                   Text="@(setting.Value?.ToString() ?? string.Empty)" />
                                            </span>
                                        }
                                    }
                                </CellDisplayTemplate>

                                <CellEditTemplate Context="cetCtx">
                                    @{
                                        var dataItem = (IGrouping<string, FbSetting>)cetCtx.DataItem;
                                        var fbName = cetCtx.DataColumn.FieldName;
                                        var setting = GetSetting(fbName, dataItem);

                                        if (IsBooleanDataItem(dataItem, out var isNullableBoolean))
                                        {
                                            var boolValue = (bool?)GetCellValue(fbName, dataItem);

                                            <CheckBox Value="@boolValue"
                                                      ValueChanged="@(async (bool? value) => OnCheckedChanged(dataItem, value, fbName))"
                                                      AllowIndeterminateState="@isNullableBoolean" />
                                        }
                                        else
                                        {
                                            <div class="input-container"
                                                 @onfocusin="(_) => SetInitialValues(dataItem)"
                                                 @onpointerdown:stopPropagation>

                                                <UniversalInput @bind-Value:get="@setting.Value"
                                                                @bind-Value:set="@((e) => OnValueBindingSet(fbName, dataItem, e))"
                                                                ValueType="@setting.SettingType" />
                                            </div>

                                            <div class="validation-message-container">
                                                @if (!string.IsNullOrEmpty(_validationMessage))
                                                {
                                                    <span title="@_validationMessage">
                                                        @_validationMessage
                                                    </span>
                                                }
                                            </div>
                                        }
                                    }
                                </CellEditTemplate>
                            </DxGridDataColumn>
                        }

                        <DxGridDataColumn Caption="@CommonVocabulary.Comment"
                                          DataRowEditorVisible="false"
                                          FieldName="@CommentColumnKey"
                                          FixedPosition="GridColumnFixedPosition.Right"
                                          ShowInColumnChooser="false"
                                          UnboundType="GridUnboundColumnType.String"
                                          Width="328px" />
                    </Columns>
                </DxGrid>
            </div>
        </div>
    </Body>

    <Footer>
        <DialogFooterButton OnClick="@OnDialogOk"
                            Text="@CommonVocabulary.Ok" />

        <DialogFooterButton OnClick="@OnClose"
                            Text="@CommonVocabulary.Cancel" />
    </Footer>
</Dialog>

@using ViciOne.Ui.Blazor.Components.SearchBox
@using ViciOne.Ui.Localization.Resources
@using CommonVocabulary = ViciOne.Ui.Localization.Resources.CommonVocabulary

<div class="search-and-filter-container">
    @if (ShowHeading)
    {
        <div class="search-heading">
            @CommonVocabulary.Search
        </div>
    }

    <div class="search-body">
        <SearchBox Enabled="@SearchEnabled"
                   Placeholder="@CommonVocabulary.Search"
                   Text="@SearchText"
                   TextChanging="@SearchTextChanged" />

        <div class="command-buttons-heading">
            @Localization.SearchAndFilterComponent.SelectAndShow
        </div>

        <div class="command-buttons-container"
             style="--filter-button-column-count: @_filterButtonGridColumnCount; --system-button-column-count: @_systemButtonGridColumnCount">

            @{
                var counter = 0;

                foreach (var filterButton in FilterButtons)
                {
                    <div @onclick="filterButton.InvokeOnFilterClickedFn"
                         class="command-button @(filterButton.IsActive ? "active" : string.Empty) @(filterButton.IsDisabled ? "disabled" : string.Empty)"
                         style="grid-column: @(counter * 2 + 1)"
                         title="@filterButton.Title">

                        @if (filterButton.Icon is not null)
                        {
                            @filterButton.Icon
                        }

                        @if (filterButton.MonochromeIconName is not null)
                        {
                            <MonochromeIcon Name="filterButton.MonochromeIconName.Value"
                                            Size="MonochromeIconSize.SmallMedium" />
                        }

                    </div>

                    counter++;
                }

                counter = Math.Max(1, counter);

                if (ShowGroupingButtons)
                {
                    <div @onclick="OnExpandAllGroups"
                         class="command-button @(GroupingButtonsEnabled ? string.Empty : "disabled")"
                         style="grid-column: @(counter * 2 + 1)"
                         title="@(string.Format(UserActions.ExpandSomething, CommonVocabulary.All))">

                        <MonochromeIcon Name="MonochromeIconName.ExpandAll"
                                        Size="MonochromeIconSize.SmallMedium" />
                    </div>

                    <div @onclick="OnCollapseAllGroups"
                         class="command-button @(GroupingButtonsEnabled ? string.Empty : "disabled")"
                         style="grid-column: @(counter * 2 + 3)"
                         title="@string.Format(UserActions.CollapseSomething, CommonVocabulary.All)">

                        <MonochromeIcon Name="MonochromeIconName.CollapseAll"
                                        Size="MonochromeIconSize.SmallMedium" />
                    </div>
                }

                if (ColumnChooserSlot is not null)
                {
                    <div class="column-chooser-slot"
                         style="grid-column: @(counter * 2 + 5)">

                        @ColumnChooserSlot
                    </div>
                }
            }
        </div>
    </div>
</div>

<div @onpointercancel="@(EventHandlerProvider.AsNonRenderingEventHandler<PointerEventArgs>(OnContainerPointerCancel))"
     @onpointermove="@(EventHandlerProvider.AsNonRenderingEventHandler<PointerEventArgs>(OnContainerPointerMove))"
     @onpointerup="@(EventHandlerProvider.AsNonRenderingEventHandler<PointerEventArgs>(OnContainerPointerUp))"
     class="edge-dragging-area-container">

    @if (_edgeDraggingAreaEnabled)
    {
        <div @onpointerenter="@(() => OnIndicatorAreaPointerEnter(Side.Left))"
             @onpointerleave="@OnIndicatorAreaPointerLeave"
             @onwheel="@(EventHandlerProvider.AsNonRenderingEventHandler<WheelEventArgs>(OnWheel))"
             class="indicator-area left">

            @if (_visibleTriggerSides.Contains(Side.Left))
            {
                <div @onpointerenter="@(() => OnTriggerAreaPointerEnter(Side.Left))"
                     @onpointerleave="@OnTriggerAreaPointerLeave"
                     class="trigger-area">

                    <MonochromeIcon CssClass="adjust-icon"
                                    Name="@MonochromeIconName.ExpanderLightLeft"
                                    Size="@MonochromeIconSize.SmallMedium" />
                </div>
            }
        </div>

        <div @onpointerenter="@(() => OnIndicatorAreaPointerEnter(Side.UpperLeft))"
             @onpointerleave="@OnIndicatorAreaPointerLeave"
             @onwheel="@(EventHandlerProvider.AsNonRenderingEventHandler<WheelEventArgs>(OnWheel))"
             class="indicator-area upper-left">

            @if (_visibleTriggerSides.Contains(Side.UpperLeft))
            {
                <div @onpointerenter="@(() => OnTriggerAreaPointerEnter(Side.UpperLeft))"
                     @onpointerleave="@OnTriggerAreaPointerLeave"
                     class="trigger-area">

                    <MonochromeIcon CssClass="adjust-icon"
                                    Name="@MonochromeIconName.ExpanderLightLeft"
                                    Size="@MonochromeIconSize.SmallMedium" />
                </div>
            }
        </div>

        <div @onpointerenter="@(() => OnIndicatorAreaPointerEnter(Side.Top))"
             @onpointerleave="@OnIndicatorAreaPointerLeave"
             @onwheel="@(EventHandlerProvider.AsNonRenderingEventHandler<WheelEventArgs>(OnWheel))"
             class="indicator-area top">

            @if (_visibleTriggerSides.Contains(Side.Top))
            {
                <div @onpointerenter="@(() => OnTriggerAreaPointerEnter(Side.Top))"
                     @onpointerleave="@OnTriggerAreaPointerLeave"
                     class="trigger-area">

                    <MonochromeIcon CssClass="adjust-icon"
                                    Name="@MonochromeIconName.ExpanderLightTop"
                                    Size="@MonochromeIconSize.SmallMedium" />
                </div>
            }
        </div>

        <div @onpointerenter="@(() => OnIndicatorAreaPointerEnter(Side.UpperRight))"
             @onpointerleave="@OnIndicatorAreaPointerLeave"
             @onwheel="@(EventHandlerProvider.AsNonRenderingEventHandler<WheelEventArgs>(OnWheel))"
             class="indicator-area upper-right">

            @if (_visibleTriggerSides.Contains(Side.UpperRight))
            {
                <div @onpointerenter="@(() => OnTriggerAreaPointerEnter(Side.UpperRight))"
                     @onpointerleave="@OnTriggerAreaPointerLeave"
                     class="trigger-area">

                    <MonochromeIcon CssClass="adjust-icon"
                                    Name="@MonochromeIconName.ExpanderLightTop"
                                    Size="@MonochromeIconSize.SmallMedium" />
                </div>
            }
        </div>

        <div @onpointerenter="@(() => OnIndicatorAreaPointerEnter(Side.Right))"
             @onpointerleave="@OnIndicatorAreaPointerLeave"
             @onwheel="@(EventHandlerProvider.AsNonRenderingEventHandler<WheelEventArgs>(OnWheel))"
             class="indicator-area right">

            @if (_visibleTriggerSides.Contains(Side.Right))
            {
                <div @onpointerenter="@(() => OnTriggerAreaPointerEnter(Side.Right))"
                     @onpointerleave="@OnTriggerAreaPointerLeave"
                     class="trigger-area">

                    <MonochromeIcon CssClass="adjust-icon"
                                    Name="@MonochromeIconName.ExpanderLightRight"
                                    Size="@MonochromeIconSize.SmallMedium" />
                </div>
            }
        </div>

        <div @onpointerenter="@(() => OnIndicatorAreaPointerEnter(Side.LowerRight))"
             @onpointerleave="@OnIndicatorAreaPointerLeave"
             @onwheel="@(EventHandlerProvider.AsNonRenderingEventHandler<WheelEventArgs>(OnWheel))"
             class="indicator-area lower-right">

            @if (_visibleTriggerSides.Contains(Side.LowerRight))
            {
                <div @onpointerenter="@(() => OnTriggerAreaPointerEnter(Side.LowerRight))"
                     @onpointerleave="@OnTriggerAreaPointerLeave"
                     class="trigger-area">

                    <MonochromeIcon CssClass="adjust-icon"
                                    Name="@MonochromeIconName.ExpanderLightRight"
                                    Size="@MonochromeIconSize.SmallMedium" />
                </div>
            }
        </div>

        <div @onpointerenter="@(() => OnIndicatorAreaPointerEnter(Side.Bottom))"
             @onpointerleave="@OnIndicatorAreaPointerLeave"
             @onwheel="@(EventHandlerProvider.AsNonRenderingEventHandler<WheelEventArgs>(OnWheel))"
             class="indicator-area bottom">

            @if (_visibleTriggerSides.Contains(Side.Bottom))
            {
                <div @onpointerenter="@(() => OnTriggerAreaPointerEnter(Side.Bottom))"
                     @onpointerleave="@OnTriggerAreaPointerLeave"
                     class="trigger-area">

                    <MonochromeIcon CssClass="adjust-icon"
                                    Name="@MonochromeIconName.ExpanderLightDown"
                                    Size="@MonochromeIconSize.SmallMedium" />
                </div>
            }
        </div>

        <div @onpointerenter="@(() => OnIndicatorAreaPointerEnter(Side.LowerLeft))"
             @onpointerleave="@OnIndicatorAreaPointerLeave"
             @onwheel="@(EventHandlerProvider.AsNonRenderingEventHandler<WheelEventArgs>(OnWheel))"
             class="indicator-area lower-left">

            @if (_visibleTriggerSides.Contains(Side.LowerLeft))
            {
                <div @onpointerenter="@(() => OnTriggerAreaPointerEnter(Side.LowerLeft))"
                     @onpointerleave="@OnTriggerAreaPointerLeave"
                     class="trigger-area">

                    <MonochromeIcon CssClass="adjust-icon"
                                    Name="@MonochromeIconName.ExpanderLightDown"
                                    Size="@MonochromeIconSize.SmallMedium" />
                </div>
            }
        </div>
    }
</div>

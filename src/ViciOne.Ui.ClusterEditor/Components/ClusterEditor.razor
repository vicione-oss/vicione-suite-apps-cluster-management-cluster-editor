@using ViciOne.Ui.Blazor.Components.EditorLayout
@using ViciOne.Ui.ClusterEditor.Components.ContainerBreadcrumb
@using ViciOne.Ui.ClusterEditor.Components.ContextMenu.Specialized

<div class="cluster-editor"
     @onclick="@InputEventService.InvokeClicked"
     @onpointerdown="@InputEventService.InvokePointerDown"
     @onpointerleave="@InputEventService.InvokePointerLeave"
     @onpointermove="@InputEventService.InvokePointerMove"
     @onpointerup="@InputEventService.InvokePointerUp"
     @ref="FullscreenService.DataflowEditorContainerReference">

    <EditorLayout>
        <Left>
            <InfrastructureToolbar />
        </Left>

        <Top>
            <MainToolbar />
        </Top>

        <Right>
            <DataflowToolbar />
        </Right>

        <Center>
            <NodeEditor />
        </Center>

        <Bottom>
            <ContainerBreadcrumb />
        </Bottom>
    </EditorLayout>

    <BlockNodeConnectorContextMenu />
    <NodeEditorContextMenu />

    <LinkDestinationDialog />
    <DraggingConnector />
    <DraggingDataPoint />

    <Tooltip />
</div>

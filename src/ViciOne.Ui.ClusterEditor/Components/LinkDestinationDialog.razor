@using ViciOne.Ui.Blazor.Components.Dialog.Components
@using ViciOne.Ui.Blazor.Components.SearchBox
@using ViciOne.Ui.Blazor.Components.Tables.AdvancedTable.Components.ColumnChooser
@using ViciOne.Ui.Blazor.Components.Tables.AdvancedTable.Components.Footers
@using ViciOne.Ui.Blazor.Components.Tables.Shared.Enums
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components.Columns
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components.Columns.SimpleTableSelectColumn
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components.Filters
@using ViciOne.Ui.Blazor.Components.Toolbar.Components
@using ViciOne.Ui.Blazor.Components.Toolbar.Enums
@using ViciOne.Ui.ClusterEditor.Models.Comparer
@using CommonVocabulary = ViciOne.Ui.Localization.Resources.CommonVocabulary
@using TechnicalTerms = ViciOne.Ui.ClusterEditor.Localization.Resources.TechnicalTerms

<Dialog @ref="_refDialog"
        CloseOnEscape="true"
        HeaderText="@_heading"
        Height="@DialogSizes.LargeHeight"
        OnClosing="OnDialogClosing"
        OnShowing="OnDialogShowing"
        Visible="@DialogService.Visible"
        VisibleChanged="VisibleChanged"
        Width="@DialogSizes.LargeWidth">

    <HeaderSlot>
        <Toolbar>
            <ToolbarGroup AlignRight="true">
                <ToolbarContent>
                    <div class="search-container">
                        <SearchBox Placeholder="@CommonVocabulary.Search"
                                   Text="@_searchText"
                                   TextChanging="SearchTextChanging" />
                    </div>
                </ToolbarContent>
            </ToolbarGroup>

            <ToolbarGroup AlignRight="true">
                <ColumnChooserToggle Id="@_columnChooserToggleId"
                                     OpenPopupToLeft="true">

                    <Button>
                        <ToolbarButton Active="@context.PopupVisible"
                                       IconName="@MonochromeIconName.ColumnChooserMenu"
                                       OnClick="@context.Toggle"
                                       Text="@context.PopupTitle"
                                       TextVisibility="@TextVisibility.MenuOnly" />
                    </Button>
                </ColumnChooserToggle>
            </ToolbarGroup>
        </Toolbar>
    </HeaderSlot>

    <Body>
        <div class="content-container">
            <div class="content">
                <SimpleTable @bind-FilterState="_filterState"
                             @bind-SelectedItems="_selectedItems"
                             ColumnChooserToggleId="@_columnChooserToggleId"
                             Items="@_items"
                             MaximumHeight="100%"
                             Mode="TableLoadingMode.Virtualize"
                             RowClickSelectionEnabled="@(!DialogService.IsDeletionMode)"
                             RowDoubleClick="RowDoubleClick"
                             SelectionMode="TableSelectionMode"
                             SortingState="_initialSorting"
                             TItem="object"
                             VisibleSelectionChanged="OnVisibleSelectionChanged">

                    @* Enter is a per-column callback, so a column added here without CellActivated is silent:
                       Enter does nothing while the focused cell is in it. *@
                    <Columns>
                        @if (DialogService.IsDeletionMode)
                        {
                            <SimpleTableSelectColumn ShowInColumnChooser="false"
                                                     TItem="object" />
                        }

                        @if (_showConnectors)
                        {
                            <SimpleTableTemplateColumn CellActivated="RowDoubleClick"
                                                       Id="@nameof(DataGridConnectorWrapper.DesignName)"
                                                       Resizeable="true"
                                                       TItem="object"
                                                       Title="@CommonVocabulary.Design">

                                <CellContent>
                                    @{ var connector = (DataGridConnectorWrapper)context; }
                                    <div class="text-truncated" title="@connector.DesignName">
                                        <SearchHighlighter SearchText="@_searchText"
                                                           Text="@connector.DesignName" />
                                    </div>
                                </CellContent>
                                <FilterEditor>
                                    <SimpleTableContainsColumnFilterEditor TItem="object"
                                                                           ValueSelector="@(x => ((DataGridConnectorWrapper)x).DesignName)" />
                                </FilterEditor>
                            </SimpleTableTemplateColumn>
                        }

                        <SimpleTableTemplateColumn CellActivated="RowDoubleClick"
                                                   Id="@nameof(DataGridConnectorWrapper.Path)"
                                                   Resizeable="true"
                                                   TItem="object"
                                                   Title="@CommonVocabulary.Path">

                            <CellContent>
                                <div class="text-truncated" title="@GetPath(context)">
                                    <SearchHighlighter SearchText="@_searchText"
                                                       Text="@GetPath(context)" />
                                </div>
                            </CellContent>
                            <FilterEditor>
                                <SimpleTableContainsColumnFilterEditor TItem="object"
                                                                       ValueSelector="GetPath" />
                            </FilterEditor>
                        </SimpleTableTemplateColumn>

                        @if (_showConnectors)
                        {
                            <SimpleTableTemplateColumn CellActivated="RowDoubleClick"
                                                       Id="@nameof(DataGridConnectorWrapper.FunctionBlockId)"
                                                       Resizeable="true"
                                                       SortComparer="AlphaNumericComparer.Default"
                                                       SortExpression="s_connectorSortExpression"
                                                       TItem="object"
                                                       Title="@TechnicalTerms.FunctionBlock">

                                <CellContent>
                                    @{ var connector = (DataGridConnectorWrapper)context; }
                                    <div class="text-truncated" title="@connector.FunctionBlockName">
                                        <SearchHighlighter SearchText="@_searchText"
                                                           Text="@connector.FunctionBlockName" />
                                    </div>
                                </CellContent>
                                <FilterEditor>
                                    <SimpleTableContainsColumnFilterEditor TItem="object"
                                                                           ValueSelector="@(x => ((DataGridConnectorWrapper)x).FunctionBlockName)" />
                                </FilterEditor>
                            </SimpleTableTemplateColumn>

                            <SimpleTableTemplateColumn CellActivated="RowDoubleClick"
                                                       Id="@nameof(DataGridConnectorWrapper.ConnectorName)"
                                                       Resizeable="true"
                                                       TItem="object"
                                                       Title="@TechnicalTerms.Connector">

                                <CellContent>
                                    @{ var connector = (DataGridConnectorWrapper)context; }
                                    <div class="connector-with-icon-cell">
                                        <div class="icon">
                                            @GetIconMarkup(connector)
                                        </div>
                                        <div class="value">
                                            <SearchHighlighter SearchText="@_searchText"
                                                               Text="@connector.ConnectorName" />
                                        </div>
                                    </div>
                                </CellContent>
                                <FilterEditor>
                                    <SimpleTableContainsColumnFilterEditor TItem="object"
                                                                           ValueSelector="@(x => ((DataGridConnectorWrapper)x).ConnectorName)" />
                                </FilterEditor>
                            </SimpleTableTemplateColumn>
                        }

                        @if (_showDataPorts)
                        {
                            <SimpleTableTemplateColumn CellActivated="RowDoubleClick"
                                                       Id="@nameof(DataGridDataPortWrapper.Name)"
                                                       Resizeable="true"
                                                       SortComparer="AlphaNumericComparer.Default"
                                                       SortExpression="s_dataPortSortExpression"
                                                       TItem="object"
                                                       Title="@CommonVocabulary.Name">

                                <CellContent>
                                    @{ var dataPort = (DataGridDataPortWrapper)context; }
                                    <div class="text-truncated" title="@dataPort.Name">
                                        <SearchHighlighter SearchText="@_searchText"
                                                           Text="@dataPort.Name" />
                                    </div>
                                </CellContent>
                                <FilterEditor>
                                    <SimpleTableContainsColumnFilterEditor TItem="object"
                                                                           ValueSelector="@(x => ((DataGridDataPortWrapper)x).Name)" />
                                </FilterEditor>
                            </SimpleTableTemplateColumn>
                        }

                        <SimpleTableTemplateColumn CellActivated="RowDoubleClick"
                                                   Id="@nameof(DataGridConnectorWrapper.Description)"
                                                   Resizeable="true"
                                                   TItem="object"
                                                   Title="@CommonVocabulary.Description">

                            <CellContent>
                                <div class="text-truncated" title="@GetDescription(context)">
                                    <SearchHighlighter SearchText="@_searchText"
                                                       Text="@GetDescription(context)" />
                                </div>
                            </CellContent>
                            <FilterEditor>
                                <SimpleTableContainsColumnFilterEditor TItem="object"
                                                                       ValueSelector="GetDescription" />
                            </FilterEditor>
                        </SimpleTableTemplateColumn>
                    </Columns>

                    <Footer>
                        <TableFooter SelectedItemCount="_visibleSelection.Count" />
                    </Footer>
                </SimpleTable>
            </div>
        </div>
    </Body>

    <Footer>
        <DialogFooterButton Enabled="@OkButtonEnabled"
                            OnClick="@OnDialogOk"
                            Text="@(DialogService.IsDeletionMode ? CommonVocabulary.Delete : CommonVocabulary.Ok)" />

        <DialogFooterButton OnClick="@(() => DialogService.SetVisibility(false))"
                            Text="@CommonVocabulary.Cancel" />
    </Footer>
</Dialog>

@using CommonVocabulary=ViciOne.Ui.Localization.Resources.CommonVocabulary

<DxDialog @ref="_refDialog"
          CloseOnEscape="true"
          CloseOnOutsideClick="false"
          Closing="OnDialogClosing"
          Header="@_heading"
          Height="@DialogSizes.LargeHeight"
          PreventDefaultContextMenu="@ContextMenuSettings.UseCustomMenu"
          Showing="OnDialogShowing"
          Shown="OnDialogShownAsync"
          Width="@DialogSizes.LargeWidth">

    <HeaderToolbarItems>
        <DxToolbarItem Alignment="ToolbarItemAlignment.Right">
            <Template Context="tplCtx">
                <div class="search-container">
                    <SearchBox TextChanged="@((searchText) => SearchText = searchText)" />
                </div>
            </Template>
        </DxToolbarItem>

        <DxToolbarItem AdaptiveText="@_expandAllGroupsText"
                       Alignment="ToolbarItemAlignment.Right"
                       BeginGroup="true"
                       Tooltip="@_expandAllGroupsText">

            <Template Context="tplCtx">
                @{
                    var adaptiveTextVisible = tplCtx.HiddenToAdaptiveMenu;
                }
                <button @onclick="OnExpandAllGroups"
                        class="btn btn-toolbar smaller-icon @(_groupingButtonsEnabled ? string.Empty : "disabled") @(adaptiveTextVisible ? "adaptive-hidden" : string.Empty)">

                    <MonochromeIcon Name="MonochromeIconName.ExpandAll"
                                    Size="MonochromeIconSize.SmallMedium" />

                    @if (adaptiveTextVisible)
                    {
                        <span>@tplCtx.AdaptiveText</span>
                    }
                </button>
            </Template>
        </DxToolbarItem>

        <DxToolbarItem AdaptiveText="@_collapseAllGroupsText"
                       Alignment="ToolbarItemAlignment.Right"
                       Tooltip="@_collapseAllGroupsText">

            <Template Context="tplCtx">
                @{
                    var adaptiveTextVisible = tplCtx.HiddenToAdaptiveMenu;
                }
                <button @onclick="OnCollapseAllGroups"
                        class="btn btn-toolbar smaller-icon @(_groupingButtonsEnabled ? string.Empty : "disabled") @(adaptiveTextVisible ? "adaptive-hidden" : string.Empty)">

                    <MonochromeIcon Name="MonochromeIconName.CollapseAll"
                                    Size="MonochromeIconSize.SmallMedium" />

                    @if (adaptiveTextVisible)
                    {
                        <span>@tplCtx.AdaptiveText</span>
                    }
                </button>
            </Template>
        </DxToolbarItem>

        <DxToolbarItem AdaptiveText="@TechnicalTerms.ColumnChooser"
                       Alignment="ToolbarItemAlignment.Right"
                       Tooltip="@TechnicalTerms.ColumnChooser">

            <Template Context="tplCtx">
                @{
                    var adaptiveTextVisible = tplCtx.HiddenToAdaptiveMenu;
                }
                <button @onclick="OnShowColumnChooser"
                        class="btn btn-toolbar smaller-icon @(adaptiveTextVisible ? "adaptive-hidden" : string.Empty)"
                        id="@_columnChooserId">

                    <MonochromeIcon Name="MonochromeIconName.ColumnChooserEditor"
                                    Size="MonochromeIconSize.SmallMedium" />

                    @if (adaptiveTextVisible)
                    {
                        <span>@tplCtx.AdaptiveText</span>
                    }
                </button>
            </Template>
        </DxToolbarItem>
    </HeaderToolbarItems>

    <Body>
        <div class="content-container">
            <div class="content">
                <DxGrid @ref="@_refGrid"
                        CssClass="dialog-grid"
                        CustomGroup="OnCustomizeCustomGroup"
                        CustomizeCellDisplayText="OnCustomizeCellDisplayText"
                        CustomSort="@OnDxGridCustomSort"
                        Data="@(DialogService.ConnectorWrappers.Any() ? DialogService.ConnectorWrappers : DialogService.DataPortWrappers)"
                        FocusedRowEnabled="@(!DialogService.IsDeletionMode)"
                        FocusedRowChanged="OnFocusedRowChanged"
                        LayoutAutoSaving="OnLayoutAutoSavingAsync"
                        RowDoubleClick="OnRowDoubleClickAsync"
                        SearchText="@SearchText"
                        SearchTextParseMode="GridSearchTextParseMode.ExactMatch"
                        SelectAllCheckboxMode="GridSelectAllCheckboxMode.AllPages"
                        SelectedDataItemsChanged="OnSelectedDataItemsChanged"
                        ShowGroupPanel="true"
                        VirtualScrollingEnabled="true">

                    <Columns>
                        @if (DialogService.IsDeletionMode)
                        {
                            <DxGridSelectionColumn ShowInColumnChooser="false"
                                                   Width="50"/>
                        }

                        @if (_showConnectors)
                        {
                            <DxGridDataColumn AllowGroup="true"
                                          AllowSort="false"
                                          Caption="@CommonVocabulary.Design"
                                          FieldName="@nameof(DataGridConnectorWrapper.DesignName)"
                                          GroupInterval="GridColumnGroupInterval.DisplayText">

                            <CellDisplayTemplate Context="cellContext">
                                @{
                                    <div class="text-truncated" title="@cellContext.DisplayText">
                                        <SearchHighlighter SearchText="@SearchText"
                                                           Text="@cellContext.DisplayText.ToString()" />
                                    </div>
                                }
                            </CellDisplayTemplate>

                            <GroupRowTemplate Context="rowContext">
                                @rowContext.GroupValue
                            </GroupRowTemplate>
                        </DxGridDataColumn>
                        }

                        <DxGridDataColumn AllowGroup="true"
                              AllowSort="false"
                              Caption="@CommonVocabulary.Path"
                              FieldName="@nameof(DataGridConnectorWrapper.Path)">

                            <CellDisplayTemplate Context="cellContext">
                                @{
                                    <div class="text-truncated" title="@cellContext.DisplayText">
                                        <SearchHighlighter SearchText="@SearchText"
                                                           Text="@cellContext.DisplayText.ToString()" />
                                    </div>
                                }
                            </CellDisplayTemplate>

                            <GroupRowTemplate Context="rowContext">
                                @{
                                    <div class="text-truncated" title="@rowContext.GroupValueDisplayText">
                                        @rowContext.GroupValueDisplayText
                                    </div>
                                }
                            </GroupRowTemplate>
                        </DxGridDataColumn>

                        @if (_showConnectors)
                        {
                            <DxGridDataColumn AllowGroup="true"
                                              AllowSort="true"
                                              Caption="@TechnicalTerms.FunctionBlock"
                                              FieldName="@nameof(DataGridConnectorWrapper.FunctionBlockId)"
                                              GroupInterval="GridColumnGroupInterval.Custom"
                                              SortIndex="0"
                                              SortMode="GridColumnSortMode.Custom">

                                <CellDisplayTemplate Context="cellContext">
                                    @{
                                        <div class="text-truncated" title="@cellContext.DisplayText">
                                            <SearchHighlighter SearchText="@SearchText"
                                                               Text="@cellContext.DisplayText.ToString()" />
                                        </div>
                                    }
                                </CellDisplayTemplate>

                                <GroupRowTemplate Context="rowContext">
                                    @rowContext.GroupValueDisplayText
                                </GroupRowTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn AllowGroup="true"
                                              AllowSort="false"
                                              Caption="@TechnicalTerms.Connector"
                                              FieldName="@nameof(DataGridConnectorWrapper.ConnectorName)">

                                <CellDisplayTemplate Context="cellContext">
                                    @{
                                        var publishedConnector = (DataGridConnectorWrapper)cellContext.DataItem;

                                        <div class="connector-with-icon-cell">
                                            <div class="icon">
                                                @GetIconMarkup(publishedConnector)
                                            </div>
                                            <div class="value">
                                                <SearchHighlighter SearchText="@SearchText"
                                                                   Text="@cellContext.Value.ToString()" />
                                            </div>
                                        </div>
                                    }
                                </CellDisplayTemplate>

                                <GroupRowTemplate Context="rowContext">
                                    @{
                                        var publishedConnector = (DataGridConnectorWrapper)rowContext.Grid.GetDataItem(rowContext.VisibleIndex);

                                        <div class="connector-with-icon-cell">
                                            <div class="icon">
                                                @GetIconMarkup(publishedConnector)
                                            </div>
                                            <div class="value">
                                                @rowContext.GroupValueDisplayText.ToString()
                                            </div>
                                        </div>
                                    }
                                </GroupRowTemplate>
                            </DxGridDataColumn>
                        }

                        @if (_showDataPorts)
                        {
                            <DxGridDataColumn AllowGroup="true"
                                              AllowSort="true"
                                              Caption="@CommonVocabulary.Name"
                                              FieldName="@nameof(DataGridDataPortWrapper.Name)"
                                              GroupInterval="GridColumnGroupInterval.DisplayText"
                                              SortIndex="0"
                                              SortMode="GridColumnSortMode.DisplayText">

                                <CellDisplayTemplate Context="cellContext">
                                    @{
                                        <div class="text-truncated" title="@cellContext.DisplayText">
                                            <SearchHighlighter SearchText="@SearchText"
                                                               Text="@cellContext.DisplayText.ToString()" />
                                        </div>
                                    }
                                </CellDisplayTemplate>

                                <GroupRowTemplate Context="rowContext">
                                    @rowContext.GroupValueDisplayText
                                </GroupRowTemplate>
                            </DxGridDataColumn>
                        }

                        <DxGridDataColumn AllowGroup="true"
                                          AllowSort="false"
                                          Caption="@CommonVocabulary.Description"
                                          FieldName="@nameof(DataGridConnectorWrapper.Description)">

                            <CellDisplayTemplate Context="cellContext">
                                @{
                                    <div class="text-truncated" title="@cellContext.DisplayText">
                                        <SearchHighlighter SearchText="@SearchText"
                                                           Text="@cellContext.DisplayText.ToString()" />
                                    </div>
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                    </Columns>

                </DxGrid>
            </div>
        </div>
    </Body>

    <Footer>
        <DxDialogFooterButton Enabled="@_okButtonEnabled"
                              OnClick="@OnDialogOk"
                              Text="@(DialogService.IsDeletionMode ? CommonVocabulary.Delete : CommonVocabulary.Ok)" />

        <DxDialogFooterButton OnClick="@(() => DialogService.SetVisibility(false))"
                              Text="@CommonVocabulary.Cancel" />
    </Footer>
</DxDialog>

@using ViciOne.Ui.ClusterEditor.Components.ConnectorDialogs
@using ViciOne.Ui.ClusterEditor.Components.ContainerEditor
@using ViciOne.Ui.ClusterEditor.Components.FbSettingsEditor
@using ViciOne.Ui.Shared.Dx.Components.Scrolling

<div class="node-editor-container">
    <CascadingValue IsFixed="true"
                    Value="@_diagram">

        <div @onclick:stopPropagation
             @oncontextmenu="@ShowContextMenuAsync"
             @oncontextmenu:preventDefault="@ContextMenuSettings.UseCustomMenu"
             @oncontextmenu:stopPropagation
             @onpointerdown="@OnContainerPointerDown"
             @onpointerdown:stopPropagation
             @onpointerup:stopPropagation
             class="diagram-container"
             style="--node-alignment-border-visibility: @(_isNodeAlignmentBorderVisible ? "visible" : "hidden");">

            <DiagramCanvas />

            <Grid Mode="@DiagramService.DiagramState.GridMode"
                  Size="@DiagramSettings.DefaultGridSize"
                  VisibleUntil="0.5" />

            <EdgeDraggingArea />

            <SelectBox Height="@(_draggingViewRectangle?.Height ?? 0)"
                       IsVisible="@(_draggingViewRectangle is not null)"
                       Left="@(_draggingViewRectangle?.Left ?? 0)"
                       Top="@(_draggingViewRectangle?.Top ?? 0)"
                       Width="@(_draggingViewRectangle?.Width ?? 0)" />

            <Minimap WidthPercentage="0.20" />

            <LabelEditor @ref="_labelEditor" />

            <ConnectorSelectionDialog />
            <ContainerEditor />
            <FbSettingsEditor />
        </div>

        <div @ondragenter="OnContainerGhostDragEnterAsync"
             @ondragenter:stopPropagation
             @ondragleave="OnContainerGhostDragLeave"
             @ondragleave:stopPropagation
             @ondragover="OnContainerGhostDragOver"
             @ondragover:preventDefault
             @ondragover:stopPropagation
             @ondrop="OnContainerGhostDrop"
             @ondrop:stopPropagation
             class="drag-and-drop-ghost @(_libraryDragInProgress ? "visible" : string.Empty)"
             dropzone="true">
        </div>

        <DiagramScrollbarAdapter Orientation="@ScrollbarOrientation.Vertical" />
        <DiagramScrollbarAdapter Orientation="@ScrollbarOrientation.Horizontal" />
    </CascadingValue>
</div>

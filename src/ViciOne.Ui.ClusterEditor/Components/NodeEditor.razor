@using ViciOne.Ui.ClusterEditor.Components.ConnectorDialogs
@using ViciOne.Ui.ClusterEditor.Components.ContainerEditor
@using ViciOne.Ui.ClusterEditor.Components.FbSettingsEditor
@using ViciOne.Ui.ClusterEditor.Components.Scrolling

<div class="node-editor-container">
    <CascadingValue IsFixed="true"
                    Value="@_diagram">

        <div @onclick:stopPropagation
             @oncontextmenu="@ShowContextMenu"
             @oncontextmenu:preventDefault
             @oncontextmenu:stopPropagation
             @onpointerdown="@DiagramPointerInteractionController.OnContainerPointerDown"
             @onpointerdown:stopPropagation
             @onpointerup:stopPropagation
             class="diagram-container"
             style="--node-alignment-border-visibility: @(_isNodeAlignmentBorderVisible ? "visible" : "hidden");">

            <DiagramCanvas />

            <Grid Mode="@DiagramService.DiagramState.GridMode"
                  Size="@DiagramSettings.DefaultGridSize"
                  VisibleUntil="0.5" />

            <EdgeDraggingArea />

            <SelectBox Height="@(DiagramPointerInteractionController.ViewRectangle?.Height ?? 0)"
                       IsVisible="@(DiagramPointerInteractionController.ViewRectangle is not null)"
                       Left="@(DiagramPointerInteractionController.ViewRectangle?.Left ?? 0)"
                       Top="@(DiagramPointerInteractionController.ViewRectangle?.Top ?? 0)"
                       Width="@(DiagramPointerInteractionController.ViewRectangle?.Width ?? 0)" />

            <Minimap WidthPercentage="0.20" />

            <LabelEditor @ref="_labelEditor" />

            <ConnectorSelectionDialog />
            <ContainerEditor />
            <FbSettingsEditor />
        </div>

        <div @ondragenter="LibraryGhostDragController.OnContainerGhostDragEnter"
             @ondragenter:stopPropagation
             @ondragleave="LibraryGhostDragController.OnContainerGhostDragLeave"
             @ondragleave:stopPropagation
             @ondragover="LibraryGhostDragController.OnContainerGhostDragOver"
             @ondragover:preventDefault
             @ondragover:stopPropagation
             @ondrop="LibraryGhostDragController.OnContainerGhostDrop"
             @ondrop:stopPropagation
             class="drag-and-drop-ghost @(LibraryGhostDragController.DragInProgress ? "visible" : string.Empty)"
             dropzone="true">
        </div>

        <DiagramScrollbarAdapter Orientation="@ScrollbarOrientation.Vertical" />
        <DiagramScrollbarAdapter Orientation="@ScrollbarOrientation.Horizontal" />
    </CascadingValue>
</div>

@if (!Node!.Visible) { return; }

<div @oncontextmenu="OnContextMenuAsync"
     @oncontextmenu:preventDefault="@ContextMenuSettings.UseCustomMenu"
     @oncontextmenu:stopPropagation
     @ondblclick="OnDoubleClickAsync"
     @onpointerdown="@OnBlockContainerPointerDown"
     @onpointerenter="@OnBlockContainerPointerEnter"
     @onpointerleave="@OnBlockContainerPointerLeave"
     class="block-container">

    <div class="alignment-border"></div>

    <div @ondblclick="@OnTitleDblClick"
         @ondblclick:stopPropagation
         class="title-container"
         style="--title-name-background-color: @Node!.NameBackgroundColor; --title-name-fore-color: @Node.NameForeColor">

        @Node.Name
    </div>

    <div class="block-info-container">
        <div @onpointerenter="@OnEngineDisplayTextPointerEnter"
             @onpointerleave="@OnEngineDisplayTextPointerLeave"
             class="engine-display-text"
             style="--engine-background-color: @Node.EngineBackgroundColor;">

            @Node.EngineDisplayText
        </div>

        @if (_block.IsChildContainer)
        {
            <div class="children-elements">
                @(((ChildContainerNode)Node).ChildrenDisplayText)
            </div>
        }
        else if (_block.IsFunctionBlock)
        {
            var fbNode = (FunctionBlockNode)Node;
            var detailed = fbNode.RunModeText == "Y";

            <div class="run-mode">@fbNode.RunModeText</div>

            @if (detailed)
            {
                <div class="run-mode-cycle-settings frequency">@fbNode.CycleFrequency</div>
            }
            else
            {
                <div class="run-mode-cycle-settings spacer"></div>
            }

            <div class="run-mode-dummy"></div>
        }
    </div>

    <div class="block-image-container">
        @if (_isImageVisible)
        {
            <div class="block-image">
                @if (string.IsNullOrEmpty(Node.ImageSrc))
                {
                    <span>@Node.ImageText</span>
                }
                else
                {
                    <img src="@Node.ImageSrc" />
                }
            </div>

            @if (_block.IsFunctionBlock && !((FunctionBlockNode)Node).Enabled)
            {
                <div class="block-image-disabled-overlay" />
            }
        }
    </div>

    @for (var (i, displayAll) = (0, ShouldDisplayAllConnectors()); i < Node.Connectors!.Count; i++)
    {
        var inputConnector = Node.Connectors[i][0];
        var outputConnector = Node.Connectors[i][1];

        <div class="connector-row @(i == 3 ? "divider" : "") @(i == Node.Connectors.Count - 1 ? "last-row" : "")">

            @if (displayAll)
            {
                if (inputConnector is not null)
                {
                    @InputConnectorFragment(inputConnector)
                }

                if (outputConnector is not null)
                {
                    @OutputConnectorFragment(outputConnector)
                }
            }
            else
            {
                if (inputConnector is not null && inputConnector.ShouldDisplayConnector())
                {
                    @InputConnectorFragment(inputConnector)
                }

                if (outputConnector is not null && outputConnector.ShouldDisplayConnector())
                {
                    @OutputConnectorFragment(outputConnector)
                }
            }
        </div>
    }

    @if (Node.Selected)
    {
        <div class="block-selection"></div>
    }
</div>

@code {
    private RenderFragment<BlockNodeConnector>? _inputConnectorFragment;
    private RenderFragment<BlockNodeConnector> InputConnectorFragment
        => _inputConnectorFragment ??= connector => __builder =>
    {
        if (!connector.Visible) { return; }

        <div @ondrop="@((_) => OnDrop(connector))"
             class="input-connector-container"
             ondragover="@(connector.IsValidDropTarget ? "event.preventDefault();" : string.Empty)"
             style="@connector.ConnectorContainerStyle">

            <div @oncontextmenu="@(async (e) => await OnConnectorContextMenuRequestedAsync(e, connector))"
                 @oncontextmenu:preventDefault="@ContextMenuSettings.UseCustomMenu"
                 @oncontextmenu:stopPropagation
                 @ondblclick="@(async (e) => await OnConnectorDblClickAsync(e, connector))"
                 @ondblclick:stopPropagation
                 @onpointerenter="@((e) => OnPortContainerPointerEnter(e, connector))"
                 @onpointerleave="@OnPortContainerPointerLeave"
                 class="input-port-container"
                 style="@connector.PortStyle">

                <PortRenderer @key="connector" Port="@connector">
                    @if (!string.IsNullOrWhiteSpace(connector.PortText))
                    {
                        <div>@connector.PortText</div>
                    }
                </PortRenderer>
            </div>

            <div class="input-pooling-mode"
                 style="@connector.PoolingModeStyle">

                @connector.PoolingMode
            </div>
            
            <div class="input-text @(connector.HasChangedProperties ? "non-default-properties" : string.Empty)"
                 style="@connector.TextStyle">

                @connector.Text
            </div>
        </div>

        var (outerLine, innerLine) = GetMarkerLines(connector);
        if (outerLine is { } outer)
        {
            <div class="marker-line input @outer.Modifier" style="--marker-line-length: @outer.Length"></div>

            if (innerLine is { } inner)
            {
                <div class="marker-line input @inner.Modifier" style="--marker-line-length: @inner.Length"></div>
            }
        }

        if (connector.PublishedConnectorMarker.Visible)
        {
            var count = connector.PublishedConnectorMarker.Links.Count;

            <div @onclick="@((e) => OnMarkerClick(e.CtrlKey, connector.PublishedConnectorMarker))"
                 @onclick:stopPropagation
                 @oncontextmenu:preventDefault="@ContextMenuSettings.UseCustomMenu"
                 @oncontextmenu:stopPropagation
                 @ondblclick="@(async () => await OnMarkerDoubleClickAsync(connector.PublishedConnectorMarker))"
                 @ondblclick:stopPropagation
                 @onpointerenter="@((e) => OnPublishMarkerPointerEnter(e, connector))"
                 @onpointerleave="@OnPublishMarkerPointerLeave"
                 class="marker publish input @(connector.PublishedConnectorMarker.Selected ? "selected" : "regular")" 
                 style="--publish-marker-background-color: @(count == 0 ? BlockNodeColors.UnusedPublishedConnector : connector.PortColor); --publish-marker-text-color: @connector.PortTextColor">

                @if (count > 0)
                {
                    @count
                }
            </div>
        }

        if (connector.DataPortConnectorMarker.Visible)
        {
            <div @onclick="@((e) => OnMarkerClick(e.CtrlKey, connector.DataPortConnectorMarker))"
                 @onclick:stopPropagation
                 @oncontextmenu:preventDefault="@ContextMenuSettings.UseCustomMenu"
                 @oncontextmenu:stopPropagation
                 @ondblclick="@(async () => await OnMarkerDoubleClickAsync(connector.DataPortConnectorMarker))"
                 @ondblclick:stopPropagation
                 @onpointerenter="@((e) => OnDataPortMarkerPointerEnter(e, connector))"
                 @onpointerleave="@OnDataPortMarkerPointerLeave"
                 class="marker dataport input @(connector.DataPortConnectorMarker.Selected ? "selected" : string.Empty)"
                 style="@connector.DataPortMarkerStyle">

                @connector.DataPortConnectorMarker.Links.Count
            </div>
        }

        if (connector.IsOnContainer)
        {
            <div @ondblclick="@(() => OnContainerMarkerDblClick(connector))"
                 @ondblclick:stopPropagation
                 @oncontextmenu:preventDefault="@ContextMenuSettings.UseCustomMenu"
                 @oncontextmenu:stopPropagation
                 @onpointerenter="@((e) => OnParentContainerMarkerPointerEnter(e, connector))"
                 @onpointerleave="@OnParentContainerMarkerPointerLeave"
                 class="marker connector-container input @(connector.HasUpstreamLinks ? "sliced" : string.Empty)"
                 style="@connector.ContainerMarkerStyle">

                <span>@connector.ParentContainerConnector?.ShortName</span>
            </div>
        }
    };

    private RenderFragment<BlockNodeConnector>? _outputConnectorFragment;
    private RenderFragment<BlockNodeConnector> OutputConnectorFragment
        => _outputConnectorFragment ??= connector => __builder =>
    {
        if (!connector.Visible) { return; }

        <div @ondrop="@((_) => OnDrop(connector))"
             class="output-connector-container"
             ondragover="@(connector.IsValidDropTarget ? "event.preventDefault();" : string.Empty)"
             style="@connector.ConnectorContainerStyle">

            <div class="output-text @(connector.HasChangedProperties ? "non-default-properties" : string.Empty)"
                 style="@connector.TextStyle">

                @connector.Text
            </div>

            <div @oncontextmenu="@(async (e) => await OnConnectorContextMenuRequestedAsync(e, connector))"
                 @oncontextmenu:preventDefault="@ContextMenuSettings.UseCustomMenu"
                 @oncontextmenu:stopPropagation
                 @ondblclick="@(async (e) => await OnConnectorDblClickAsync(e, connector))"
                 @ondblclick:stopPropagation
                 @onpointerenter="@((e) => OnPortContainerPointerEnter(e, connector))"
                 @onpointerleave="@OnPortContainerPointerLeave"
                 class="output-port-container"
                 style="@connector.PortStyle">

                <PortRenderer @key="connector" Port="@connector">
                    @if (!string.IsNullOrWhiteSpace(connector.PortText))
                    {
                        <div>@connector.PortText</div>
                    }
                </PortRenderer>
            </div>
        </div>

        var (outerLine, innerLine) = GetMarkerLines(connector);
        if (outerLine is { } outer)
        {
            <div class="marker-line output @outer.Modifier" style="--marker-line-length: @outer.Length"></div>

            if (innerLine is { } inner)
            {
                <div class="marker-line output @inner.Modifier" style="--marker-line-length: @inner.Length"></div>
            }
        }

        if (connector.IsOnContainer)
        {
            <div @ondblclick="@(() => OnContainerMarkerDblClick(connector))"
                 @ondblclick:stopPropagation
                 @oncontextmenu:preventDefault="@ContextMenuSettings.UseCustomMenu"
                 @oncontextmenu:stopPropagation
                 @onpointerenter="@((e) => OnParentContainerMarkerPointerEnter(e, connector))"
                 @onpointerleave="@OnParentContainerMarkerPointerLeave"
                 class="marker connector-container output @(connector.HasUpstreamLinks ? "sliced" : string.Empty)"
                 style="@connector.ContainerMarkerStyle">

                <span>@connector.ParentContainerConnector?.ShortName</span>
            </div>
        }

        if (connector.DataPortConnectorMarker.Visible)
        {
            <div @onclick="(args) => OnMarkerClick(args.CtrlKey, connector.DataPortConnectorMarker)"
                 @onclick:stopPropagation
                 @oncontextmenu:preventDefault="@ContextMenuSettings.UseCustomMenu"
                 @oncontextmenu:stopPropagation
                 @ondblclick="async (_) => await OnMarkerDoubleClickAsync(connector.DataPortConnectorMarker)"
                 @ondblclick:stopPropagation
                 @onpointerenter="@((e) => OnDataPortMarkerPointerEnter(e, connector))"
                 @onpointerleave="@OnDataPortMarkerPointerLeave"
                 class="marker dataport output @(connector.DataPortConnectorMarker.Selected ? "selected" : string.Empty)"
                 style="@connector.DataPortMarkerStyle">

                @connector.DataPortConnectorMarker.Links.Count
            </div>
        }

        if (connector.PublishedConnectorMarker.Visible)
        {
            var count = connector.PublishedConnectorMarker.Links.Count;

            <div @onclick="(args) => OnMarkerClick(args.CtrlKey, connector.PublishedConnectorMarker)"
                 @onclick:stopPropagation
                 @oncontextmenu:preventDefault="@ContextMenuSettings.UseCustomMenu"
                 @oncontextmenu:stopPropagation
                 @ondblclick="async (_) => await OnMarkerDoubleClickAsync(connector.PublishedConnectorMarker)"
                 @ondblclick:stopPropagation
                 @onpointerenter = "@((e) => OnPublishMarkerPointerEnter(e, connector))"
                 @onpointerleave="@OnPublishMarkerPointerLeave"
                 class="marker publish output @(connector.PublishedConnectorMarker.Selected ? "selected" : "regular")"
                 style="--publish-marker-background-color: @(count == 0 ? BlockNodeColors.UnusedPublishedConnector : connector.PortColor); --publish-marker-text-color: @connector.PortTextColor">

                @if (count > 0)
                {
                    @count
                }
            </div>
        }
    };
}

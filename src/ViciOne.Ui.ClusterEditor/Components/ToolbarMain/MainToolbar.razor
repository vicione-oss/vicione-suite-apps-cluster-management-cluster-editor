@using ViciOne.Ui.Blazor.Components.Toolbar.Components
@using ViciOne.Ui.Blazor.Components.Toolbar.Enums
@using ViciOne.Ui.Localization.Resources
@using TechnicalTerms=ViciOne.Ui.Localization.Resources.TechnicalTerms

<div class="sidebar-top-container">
    <Toolbar>
        <ToolbarButton Enabled="@_alignButtonsEnabledState"
                       IconName="@MonochromeIconName.AlignTop"
                       OnClick="@(() => OnNodeAlignRequested(Alignment.Top))"
                       Text="@UserActions.AlignTop"
                       TextVisibility="TextVisibility.MenuOnly"
                       Tooltip="@UserActions.AlignTop"/>

        <ToolbarButton Enabled="@_alignButtonsEnabledState"
                       IconName="@MonochromeIconName.AlignTopByLowestElement"
                       OnClick="@(() => OnNodeAlignRequested(Alignment.TopByLowestElement))"
                       Text="@UserActions.AlignTopByLowest"
                       TextVisibility="TextVisibility.MenuOnly"
                       Tooltip="@UserActions.AlignTopByLowest"/>
    
        <ToolbarButton Enabled="@_alignButtonsEnabledState"
                       IconName="@MonochromeIconName.AlignBottom"
                       OnClick="@(() => OnNodeAlignRequested(Alignment.Bottom))"
                       Text="@UserActions.AlignBottom"
                       TextVisibility="TextVisibility.MenuOnly"
                       Tooltip="@UserActions.AlignBottom"/>

        <ToolbarButton Enabled="@_alignButtonsEnabledState"
                       IconName="@MonochromeIconName.AlignLeft"
                       OnClick="@(() => OnNodeAlignRequested(Alignment.Left))"
                       Text="@UserActions.AlignLeft"
                       TextVisibility="TextVisibility.MenuOnly"
                       Tooltip="@UserActions.AlignLeft"/>
    
        <ToolbarButton Enabled="@_alignButtonsEnabledState"
                       IconName="@MonochromeIconName.AlignRight"
                       OnClick="@(() => OnNodeAlignRequested(Alignment.Right))"
                       Text="@UserActions.AlignRight"
                       TextVisibility="TextVisibility.MenuOnly"
                       Tooltip="@UserActions.AlignRight"/>
    
        <ToolbarGroup>
            <ToolbarContent>
                <ZoomDisplay Enabled="@DiagramService.DiagramState.IsInitialized"/>
            </ToolbarContent>
        </ToolbarGroup>

        <ToolbarGroup>
            <ToolbarButton Active="@_isFullscreen"
                           Enabled="@DiagramService.DiagramState.IsInitialized"
                           IconName="@MonochromeIconName.FullSizeLight"
                           OnClick="@OnToggleFullscreenClick"
                           Text="@TechnicalTerms.Fullscreen"
                           TextVisibility="@TextVisibility.MenuOnly" />
        </ToolbarGroup>

        <ToolbarGroup>
            <ToolbarButton Active="@DiagramService.DiagramState.IsMinimapVisible"
                           Enabled="@DiagramService.DiagramState.IsInitialized"
                           IconName="@MonochromeIconName.MinimapLight"
                           OnClick="@(() => DiagramService.RequestMinimapVisibilityChange(!DiagramService.DiagramState.IsMinimapVisible))"
                           Text="@Localization.MainToolbar.Minimap"
                           TextVisibility="TextVisibility.MenuOnly"
                           Tooltip="@Localization.MainToolbar.Minimap"/>
        </ToolbarGroup>
    </Toolbar>
</div>

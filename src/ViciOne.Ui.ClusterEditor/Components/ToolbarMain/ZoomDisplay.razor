@using ViciOne.Ui.Blazor.Components.ComboBox
@using ViciOne.Ui.Blazor.Components.Toolbar.Components
@using ViciOne.Ui.Blazor.Components.Toolbar.Enums

<ToolbarGroup>
    <ToolbarButton Enabled="@Enabled"
                   IconName="@MonochromeIconName.MinusSlim"
                   OnClick="@(() => ChangeZoomValue(false))"
                   Text="@Localization.ZoomDisplay.ZoomOut"
                   TextVisibility="TextVisibility.MenuOnly"
                   Tooltip="@Localization.ZoomDisplay.ZoomOut" />

    <ToolbarContent>
        <div class="zoom-selection-container">
            <ComboBox @bind-Value="ZoomText"
                      AllowUserInput="true"
                      CssClass="zoom-selection"
                      Enabled="Enabled"
                      Items="_zoomValues" />
        </div>
    </ToolbarContent>

    <ToolbarButton Enabled="@Enabled"
                   IconName="@MonochromeIconName.PlusSlim"
                   OnClick="@(() => ChangeZoomValue(true))"
                   Text="@Localization.ZoomDisplay.ZoomIn"
                   TextVisibility="TextVisibility.MenuOnly"
                   Tooltip="@Localization.ZoomDisplay.ZoomIn" />
</ToolbarGroup>

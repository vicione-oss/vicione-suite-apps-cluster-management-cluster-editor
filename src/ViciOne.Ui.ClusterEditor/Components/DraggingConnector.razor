<div class="dragging-connector"
     style="--connector-color: @_connectorColor;
            --visible: @(_visible ? "visible" : "hidden");
            --top: @Razor.GetCssPx(_position?.Y + 16 ?? 0);
            --left: @Razor.GetCssPx(_position?.X + 16 ?? 0);">

    @if (_isInput)
    {
        <MonochromeIcon Name="MonochromeIconName.ConnectorDraggingConnectorIn"
                        Size="MonochromeIconSize.Medium" />
    }
    else
    {
        <MonochromeIcon Name="MonochromeIconName.ConnectorDraggingConnectorOut"
                        Size="MonochromeIconSize.Medium" />
    }

</div>

@using System.Globalization
@using ViciOne.Cluster.Model.Extensions
@using ViciOne.Ui.Blazor.Components.Dialog.Components
@using ViciOne.Ui.Blazor.Components.SearchBox
@using ViciOne.Ui.Blazor.Components.Toolbar.Components
@using ViciOne.Ui.Blazor.Components.Toolbar.Enums
@using ViciOne.Ui.ClusterEditor.Components.ToolbarColumnChooserButton
@using ViciOne.Ui.Localization.Resources
@using CommonVocabulary = ViciOne.Ui.Localization.Resources.CommonVocabulary
@using TechnicalTerms = ViciOne.Ui.Localization.Resources.TechnicalTerms
@using LocalTechnicalTerms = ViciOne.Ui.ClusterEditor.Localization.Resources.TechnicalTerms

@* CloseOnEscape="true" not supported yet, https://gitlab.com/vicione-oss/vicione/ui-libs/blazor-components/-/issues/141 *@
<Dialog @bind-Visible:get="DialogService.Visible"
        @bind-Visible:set="DialogService.SetVisibility"
        @ref="_refDialog"
        HeaderText="@string.Format(CultureInfo.CurrentCulture, UserActions.SelectSomething, LocalTechnicalTerms.ConnectorPlural)"
        Height="@DialogSizes.LargeHeight"
        OnClosing="@OnDialogClosing"
        OnShowing="@OnDialogShowing"
        Width="@DialogSizes.LargeWidth">

    <HeaderSlot>
        <Toolbar>
            <ToolbarGroup AlignRight="true">
                <ToolbarContent>
                    <div class="search-container">
                        <SearchBox @bind-Text="@_searchText"
                                   @bind-Text:event="TextChanging"
                                   Placeholder="@CommonVocabulary.Search" />
                    </div>
                </ToolbarContent>

                <ToolbarButton IconName="@MonochromeIconName.SelectConnectorsInput"
                               OnClick="@(() => OnFilterButton(c => c.IsInput && !c.Connector.FunctionBlock.GetSystemConnectors().ToArray().Contains(c.Connector)))"
                               Text="@_selectInputConnectorsText"
                               TextVisibility="@TextVisibility.MenuOnly" />

                <ToolbarButton IconName="@MonochromeIconName.SelectConnectorsInputAll"
                               OnClick="@(() => OnFilterButton(c => c.IsInput))"
                               Text="@_selectAllInputConnectorsText"
                               TextVisibility="@TextVisibility.MenuOnly" />

                <ToolbarButton IconName="@MonochromeIconName.SelectConnectorsInputAndOutput"
                               OnClick="@(() => OnFilterButton(c => !c.Connector.FunctionBlock.GetSystemConnectors().ToArray().Contains(c.Connector)))"
                               Text="@_selectConnectorsText"
                               TextVisibility="@TextVisibility.MenuOnly" />

                <ToolbarButton IconName="@MonochromeIconName.SelectConnectorsInputAndOutputAll"
                               OnClick="@(() => OnFilterButton(c => true))"
                               Text="@_selectAllConnectorsText"
                               TextVisibility="@TextVisibility.MenuOnly" />

                <ToolbarButton IconName="@MonochromeIconName.SelectConnectorsOutput"
                               OnClick="@(() => OnFilterButton(c => !c.IsInput && !c.Connector.FunctionBlock.GetSystemConnectors().ToArray().Contains(c.Connector)))"
                               Text="@_selectOutputConnectorsText"
                               TextVisibility="@TextVisibility.MenuOnly" />

                <ToolbarButton IconName="@MonochromeIconName.SelectConnectorsOutputAll"
                               OnClick="@(() => OnFilterButton(c => !c.IsInput))"
                               Text="@_selectAllOutputConnectorsText"
                               TextVisibility="@TextVisibility.MenuOnly" />

                <ToolbarButton IconName="@MonochromeIconName.SortUncheckAll"
                               OnClick="@(() => OnFilterButton((c) => false))"
                               Text="@Localization.ConnectorSelectionDialog.DeselectAllConnectors"
                               TextVisibility="@TextVisibility.MenuOnly" />
            </ToolbarGroup>

            <ToolbarGroup AlignRight="true">
                <ToolbarButton Enabled="@_groupingButtonsEnabled"
                               IconName="@MonochromeIconName.ExpandAll"
                               OnClick="@OnExpandAllGroups"
                               Text="@_expandAllGroupsText"
                               TextVisibility="@TextVisibility.MenuOnly" />

                <ToolbarButton Enabled="@_groupingButtonsEnabled"
                               IconName="@MonochromeIconName.CollapseAll"
                               OnClick="@OnCollapseAllGroups"
                               Text="@_collapseAllGroupsText"
                               TextVisibility="@TextVisibility.MenuOnly" />

                <ToolbarColumnChooserButton AssociatedGrid="@_refGrid" />
            </ToolbarGroup>
        </Toolbar>
    </HeaderSlot>

    <Body>
        <div class="content-container">
            <div class="content">
                <DxGrid @ref="@_refGrid"
                        CssClass="dialog-grid"
                        CustomGroup="OnCustomizeCustomGroup"
                        CustomizeCellDisplayText="OnCustomizeCellDisplayText"
                        CustomSort="@OnCustomSort"
                        Data="@_connectorWrappers"
                        SearchText="@_searchText"
                        SearchTextParseMode="GridSearchTextParseMode.ExactMatch"
                        SelectedDataItemsChanged="OnSelectedDataItemsChanged"
                        SelectionMode="GridSelectionMode.Multiple"
                        ShowGroupPanel="true"
                        VirtualScrollingEnabled="true">

                    <Columns>
                        <DxGridSelectionColumn AllowSelectAll="false"
                                               ShowInColumnChooser="false"
                                               Width="50" />

                        <DxGridDataColumn AllowGroup="true"
                                          AllowSort="true"
                                          Caption="@CommonVocabulary.Element"
                                          FieldName="@nameof(DataGridConnectorWrapper.ParentName)"
                                          GroupIndexChanged="SetGroupingButtonsState"
                                          GroupInterval="GridColumnGroupInterval.DisplayText"
                                          SortIndex="1">

                            <CellDisplayTemplate Context="cellContext">
                                @{
                                    <div class="text-truncated" title="@cellContext.DisplayText">
                                        <ViciOne.Ui.Shared.Dx.Components.SearchHighlighter SearchText="@_searchText"
                                                                                           Text="@cellContext.DisplayText.ToString()" />
                                    </div>
                                }
                            </CellDisplayTemplate>

                            <GroupRowTemplate Context="rowContext">
                                @rowContext.GroupValue
                            </GroupRowTemplate>
                        </DxGridDataColumn>

                        <DxGridDataColumn AllowGroup="true"
                                          AllowSort="true"
                                          Caption="@LocalTechnicalTerms.Connector"
                                          FieldName="@nameof(DataGridConnectorWrapper.ConnectorName)"
                                          GroupIndexChanged="SetGroupingButtonsState"
                                          SortIndex="2"
                                          SortMode="GridColumnSortMode.Custom">

                            <CellDisplayTemplate Context="cellContext">
                                @{
                                    var publishedConnector = (DataGridConnectorWrapper)cellContext.DataItem;

                                    <div class="connector-with-icon-cell">
                                        <div class="icon">
                                            @GetIconMarkup(publishedConnector)
                                        </div>
                                        <div class="value">
                                            <ViciOne.Ui.Shared.Dx.Components.SearchHighlighter SearchText="@_searchText"
                                                                                               Text="@cellContext.Value.ToString()" />
                                        </div>
                                    </div>
                                }
                            </CellDisplayTemplate>

                            <GroupRowTemplate Context="rowContext">
                                @{
                                    var publishedConnector = (DataGridConnectorWrapper)rowContext.Grid.GetDataItem(rowContext.VisibleIndex);

                                    <div class="connector-with-icon-cell">
                                        <div class="icon">
                                            @GetIconMarkup(publishedConnector)
                                        </div>
                                        <div class="value">
                                            @rowContext.GroupValueDisplayText.ToString()
                                        </div>
                                    </div>
                                }
                            </GroupRowTemplate>
                        </DxGridDataColumn>

                        <DxGridDataColumn AllowGroup="true"
                                          AllowSort="true"
                                          Caption="@TechnicalTerms.DataType"
                                          FieldName="@nameof(DataGridConnectorWrapper.ConnectorTypeName)"
                                          GroupIndexChanged="SetGroupingButtonsState">

                            <CellDisplayTemplate Context="cellContext">
                                @{
                                    <div class="text-truncated" title="@cellContext.DisplayText">
                                        <ViciOne.Ui.Shared.Dx.Components.SearchHighlighter SearchText="@_searchText"
                                                                                           Text="@cellContext.DisplayText.ToString()" />
                                    </div>
                                }
                            </CellDisplayTemplate>

                            <GroupRowTemplate Context="rowContext">
                                @{
                                    <div class="text-truncated" title="@rowContext.GroupValueDisplayText">
                                        @rowContext.GroupValueDisplayText
                                    </div>
                                }
                            </GroupRowTemplate>
                        </DxGridDataColumn>

                        <DxGridDataColumn AllowGroup="true"
                                          AllowSort="false"
                                          Caption="@CommonVocabulary.Description"
                                          FieldName="@nameof(DataGridConnectorWrapper.Description)"
                                          GroupIndexChanged="SetGroupingButtonsState">

                            <CellDisplayTemplate Context="cellContext">
                                @{
                                    <div class="text-truncated" title="@cellContext.DisplayText">
                                        <ViciOne.Ui.Shared.Dx.Components.SearchHighlighter SearchText="@_searchText"
                                                                                           Text="@cellContext.DisplayText.ToString()" />
                                    </div>
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                    </Columns>

                </DxGrid>
            </div>
        </div>
    </Body>

    <Footer>
        <DialogFooterButton OnClick="@OnDialogOk"
                            Text="@CommonVocabulary.Ok" />

        <DialogFooterButton OnClick="@OnDialogCancel"
                            Text="@CommonVocabulary.Cancel" />
    </Footer>
</Dialog>

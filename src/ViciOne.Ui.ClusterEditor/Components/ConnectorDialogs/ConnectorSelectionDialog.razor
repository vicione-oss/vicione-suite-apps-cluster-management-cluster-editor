@using System.Globalization
@using ViciOne.Cluster.Model.Extensions
@using ViciOne.Ui.Blazor.Components.Dialog.Components
@using ViciOne.Ui.Blazor.Components.Tables.AdvancedTable.Components.ColumnChooser
@using ViciOne.Ui.Blazor.Components.Tables.AdvancedTable.Components.Footers
@using ViciOne.Ui.Blazor.Components.Tables.Shared.Enums
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components.Columns
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components.Columns.SimpleTableSelectColumn
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components.Filters
@using ViciOne.Ui.Blazor.Components.Toolbar.Components
@using ViciOne.Ui.Blazor.Components.Toolbar.Enums
@using ViciOne.Ui.ClusterEditor.Components.ToolbarSearchbox
@using ViciOne.Ui.Localization.Resources
@using CommonVocabulary = ViciOne.Ui.Localization.Resources.CommonVocabulary
@using TechnicalTerms = ViciOne.Ui.Localization.Resources.TechnicalTerms
@using LocalTechnicalTerms = ViciOne.Ui.ClusterEditor.Localization.Resources.TechnicalTerms
@using SelectionMode = ViciOne.Ui.Blazor.Components.Tables.Shared.Enums.SelectionMode

<Dialog @bind-Visible:get="DialogService.Visible"
        @bind-Visible:set="DialogService.SetVisibility"
        @ref="_refDialog"
        CloseOnEscape="true"
        HeaderText="@string.Format(CultureInfo.CurrentCulture, UserActions.SelectSomething, LocalTechnicalTerms.ConnectorPlural)"
        Height="@DialogSizes.LargeHeight"
        OnClosing="@OnDialogClosing"
        OnShowing="@OnDialogShowing"
        Width="@DialogSizes.LargeWidth">

    <HeaderSlot>
        <Toolbar>
            <ToolbarGroup AlignRight="true">
                <ToolbarSearchbox Text="@_searchText"
                                  TextChanging="SearchTextChanging" />

                <ToolbarButton IconName="@MonochromeIconName.SelectConnectorsInput"
                               OnClick="@(() => OnFilterButton(c => c.IsInput && !c.Connector.FunctionBlock.GetSystemConnectors().ToArray().Contains(c.Connector)))"
                               Text="@_selectInputConnectorsText"
                               TextVisibility="@TextVisibility.MenuOnly" />

                <ToolbarButton IconName="@MonochromeIconName.SelectConnectorsInputAll"
                               OnClick="@(() => OnFilterButton(c => c.IsInput))"
                               Text="@_selectAllInputConnectorsText"
                               TextVisibility="@TextVisibility.MenuOnly" />

                <ToolbarButton IconName="@MonochromeIconName.SelectConnectorsInputAndOutput"
                               OnClick="@(() => OnFilterButton(c => !c.Connector.FunctionBlock.GetSystemConnectors().ToArray().Contains(c.Connector)))"
                               Text="@_selectConnectorsText"
                               TextVisibility="@TextVisibility.MenuOnly" />

                <ToolbarButton IconName="@MonochromeIconName.SelectConnectorsInputAndOutputAll"
                               OnClick="@(() => OnFilterButton(c => true))"
                               Text="@_selectAllConnectorsText"
                               TextVisibility="@TextVisibility.MenuOnly" />

                <ToolbarButton IconName="@MonochromeIconName.SelectConnectorsOutput"
                               OnClick="@(() => OnFilterButton(c => !c.IsInput && !c.Connector.FunctionBlock.GetSystemConnectors().ToArray().Contains(c.Connector)))"
                               Text="@_selectOutputConnectorsText"
                               TextVisibility="@TextVisibility.MenuOnly" />

                <ToolbarButton IconName="@MonochromeIconName.SelectConnectorsOutputAll"
                               OnClick="@(() => OnFilterButton(c => !c.IsInput))"
                               Text="@_selectAllOutputConnectorsText"
                               TextVisibility="@TextVisibility.MenuOnly" />

                @* Clears the whole selection, filtered-away rows included. *@
                <ToolbarButton IconName="@MonochromeIconName.SortUncheckAll"
                               OnClick="@OnDeselectAllButton"
                               Text="@Localization.ConnectorSelectionDialog.DeselectAllConnectors"
                               TextVisibility="@TextVisibility.MenuOnly" />
            </ToolbarGroup>

            <ToolbarGroup AlignRight="true">
                <ColumnChooserToggle Id="@_columnChooserToggleId"
                                     OpenPopupToLeft="true">

                    <Button>
                        <ToolbarButton Active="@context.PopupVisible"
                                       IconName="@MonochromeIconName.ColumnChooserMenu"
                                       OnClick="@context.Toggle"
                                       Text="@context.PopupTitle"
                                       TextVisibility="@TextVisibility.MenuOnly" />
                    </Button>
                </ColumnChooserToggle>
            </ToolbarGroup>
        </Toolbar>
    </HeaderSlot>

    <Body>
        <div class="content-container">
            <div class="content">
                <SimpleTable @bind-FilterState="_filterState"
                             @bind-SelectedItems="_selectedItems"
                             ColumnChooserToggleId="@_columnChooserToggleId"
                             FilteredItemsChanged="OnFilteredItemsChanged"
                             Items="@_connectorWrappers"
                             MaximumHeight="100%"
                             Mode="TableLoadingMode.Virtualize"
                             RowClickSelectionEnabled="false"
                             SelectionMode="SelectionMode.Multiple"
                             SortingState="_initialSorting"
                             TItem="DataGridConnectorWrapper"
                             VisibleSelectionChanged="OnVisibleSelectionChanged">

                    <Columns>
                        <SimpleTableSelectColumn HasSelectAllHeader="false"
                                                 TItem="DataGridConnectorWrapper" />

                        <SimpleTableTemplateColumn Id="@nameof(DataGridConnectorWrapper.ParentName)"
                                                   Resizeable="true"
                                                   SortExpression="s_parentNameSortExpression"
                                                   TItem="DataGridConnectorWrapper"
                                                   Title="@CommonVocabulary.Element">

                            <CellContent>
                                <div class="element-cell" title="@context.ParentName">
                                    <SearchHighlighter SearchText="@_searchText"
                                                       Text="@context.ParentName" />
                                </div>
                            </CellContent>
                            <FilterEditor>
                                <SimpleTableContainsColumnFilterEditor TItem="DataGridConnectorWrapper"
                                                                       ValueSelector="@(x => x.ParentName)" />
                            </FilterEditor>
                        </SimpleTableTemplateColumn>

                        <SimpleTableTemplateColumn Id="@nameof(DataGridConnectorWrapper.ConnectorName)"
                                                   Resizeable="true"
                                                   SortExpression="s_isOutputSortExpression"
                                                   TItem="DataGridConnectorWrapper"
                                                   Title="@LocalTechnicalTerms.Connector">

                            <CellContent>
                                <div class="connector-with-icon-cell">
                                    <div class="icon">
                                        @GetIconMarkup(context)
                                    </div>
                                    <div class="value">
                                        <SearchHighlighter SearchText="@_searchText"
                                                           Text="@context.ConnectorName" />
                                    </div>
                                </div>
                            </CellContent>
                            <FilterEditor>
                                <SimpleTableContainsColumnFilterEditor TItem="DataGridConnectorWrapper"
                                                                       ValueSelector="@(x => x.ConnectorName)" />
                            </FilterEditor>
                        </SimpleTableTemplateColumn>

                        <SimpleTableTemplateColumn Id="@nameof(DataGridConnectorWrapper.ConnectorTypeName)"
                                                   Resizeable="true"
                                                   SortExpression="s_connectorTypeNameSortExpression"
                                                   TItem="DataGridConnectorWrapper"
                                                   Title="@TechnicalTerms.DataType">

                            <CellContent>
                                <div class="data-type-cell" title="@context.ConnectorTypeName">
                                    <SearchHighlighter SearchText="@_searchText"
                                                       Text="@context.ConnectorTypeName" />
                                </div>
                            </CellContent>
                            <FilterEditor>
                                <SimpleTableContainsColumnFilterEditor TItem="DataGridConnectorWrapper"
                                                                       ValueSelector="@(x => x.ConnectorTypeName)" />
                            </FilterEditor>
                        </SimpleTableTemplateColumn>

                        <SimpleTableTemplateColumn Id="@nameof(DataGridConnectorWrapper.Description)"
                                                   Resizeable="true"
                                                   TItem="DataGridConnectorWrapper"
                                                   Title="@CommonVocabulary.Description">

                            <CellContent>
                                <div class="description-cell" title="@context.Description">
                                    <SearchHighlighter SearchText="@_searchText"
                                                       Text="@context.Description" />
                                </div>
                            </CellContent>
                            <FilterEditor>
                                <SimpleTableContainsColumnFilterEditor TItem="DataGridConnectorWrapper"
                                                                       ValueSelector="@(x => x.Description)" />
                            </FilterEditor>
                        </SimpleTableTemplateColumn>
                    </Columns>

                    <Footer>
                        <TableFooter SelectedItemCount="_visibleSelection.Count" />
                    </Footer>
                </SimpleTable>
            </div>
        </div>
    </Body>

    <Footer>
        <DialogFooterButton OnClick="@OnDialogOk"
                            Text="@CommonVocabulary.Ok" />

        <DialogFooterButton OnClick="@OnDialogCancel"
                            Text="@CommonVocabulary.Cancel" />
    </Footer>
</Dialog>

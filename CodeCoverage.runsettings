<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage settings for Visual Studio ("Analyze Code Coverage"), which does not read testconfig.json.
  Select via Test > Configure Run Settings > Select Solution Wide runsettings File.
  Keep the filters in sync with testconfig.json (used by dotnet test / CI).
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <IncludeTestAssembly>False</IncludeTestAssembly>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*[\\/]ViciOne\.Ui\.ClusterEditor\.dll$</ModulePath>
                <ModulePath>.*[\\/]ViciOne\.Ui\.ColorableIcons\.dll$</ModulePath>
              </Include>
            </ModulePaths>
            <Sources>
              <Exclude>
                <Source>.*\.Designer\.cs$</Source>
                <Source>.*[\\/]obj[\\/].*</Source>
              </Exclude>
            </Sources>
            <Attributes>
              <Exclude>
                <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
                <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
              </Exclude>
            </Attributes>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
